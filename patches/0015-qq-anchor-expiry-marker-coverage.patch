--- a/gateway/platforms/qqbot/adapter.py
+++ b/gateway/platforms/qqbot/adapter.py
@@ -107,19 +107,33 @@ class QQCloseError(Exception):
 # even though the wording contains none of the generic permanent-error
 # keywords the send path looks for.
 #
-# ``304027`` is the documented code. Live group traffic answers with
-# ``[400] code=40034031 ... msgid已经过期,不能回复`` instead — including for
-# anchors the platform refuses outright (a moderated inbound image) rather
-# than ones that merely aged out. The send path only ever sees the
-# stringified exception, so both phrasings are matched literally. The
-# Chinese markers stay anchor-specific ("msgid...", "不能回复") so an
+# ``304027`` is the documented code. Live group traffic never sends it and
+# uses two different codes with two different wordings for the same
+# condition (counts from three days of one production bot):
+#
+#   [400] code=40034031 ... msgid已经过期,不能回复      (126x)
+#   [400] code=40034005 ... 回复消息msg_id已过期        (48x)
+#
+# Note ``msgid`` in one and ``msg_id`` in the other. Because the send path
+# only ever sees the stringified exception and matches literal substrings,
+# that single underscore is enough to make a marker miss: ``msgid已过期``
+# is not a substring of ``msg_id已过期``. Underscores are therefore
+# stripped from the error text before matching and every marker is written
+# without one, so all of msgid / msg_id / msg id collapse together and a
+# future spelling flip cannot silently disable detection again.
+#
+# The Chinese markers stay anchor-specific ("msgid...", "不能回复") so an
 # unrelated ``access_token已过期`` cannot be mistaken for a dead anchor.
+# ``40034006 消息内容违规`` is deliberately absent: that is the platform
+# rejecting the outbound content itself, and resending the same body
+# without an anchor would fail again while spending push quota.
 _ANCHOR_EXPIRED_MARKERS = (
     "304027",
     "40034031",
-    "msg_expire",
+    "40034005",
+    "msgexpire",
+    "msgid expire",
     "msg id expire",
-    "msg_id expire",
     "message expire",
     "msgid已经过期",
     "msgid已过期",
@@ -129,7 +143,7 @@ _ANCHOR_EXPIRED_MARKERS = (
 
 def _is_expired_reply_anchor(error_text: str) -> bool:
     """Return True when an API error means the quoted msg_id is dead."""
-    lowered = str(error_text or "").lower()
+    lowered = str(error_text or "").lower().replace("_", "")
     return any(marker in lowered for marker in _ANCHOR_EXPIRED_MARKERS)
 
 
