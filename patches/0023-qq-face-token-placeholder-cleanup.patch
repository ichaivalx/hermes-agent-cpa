     return " ".join(ordered), remainder.strip()
 
 
+# QQ inlines an ``<faceType=N,faceId="X",ext="<base64>">`` token into ``content``
+# for two unrelated things, told apart only by the decoded ``ext`` payload:
+#
+#   * ``{"text": ""}`` — a placeholder standing in for an *image* that rides in
+#     ``attachments``. One token per attached image. Nobody typed anything; the
+#     client inserts it when a picture is sent.
+#   * ``{"text": "睁眼"}`` — a real inline emoji the sender actually picked.
+#
+# Both used to reach the model verbatim, which cost three separate defects: the
+# model read an unreadable token instead of the emoji's meaning, every attached
+# image paid tokens for a redundant marker (its path is already listed), and —
+# worst — the token made a caption-less photo look like it *had* a caption, so
+# ``_build_media_placeholder`` stopped naming the sender and announced a group
+# photo as an anonymous "User". Strip the placeholders, keep the emoji.
+_FACE_TOKEN_RE = re.compile(
+    r'<faceType=(?P<type>\d+),faceId="(?P<id>[^"]*)"(?:,ext="(?P<ext>[^"]*)")?>'
+)
+
+
+def _face_token_replacement(match: "re.Match[str]") -> str:
+    """Return the text a single QQ face token should become.
+
+    ``""`` for an image placeholder, ``[表情:睁眼]`` for a real emoji, and the
+    token verbatim when the payload cannot be decoded — an unknown shape is
+    more useful to a human reading the transcript than a silent deletion.
+    """
+    raw_ext = match.group("ext") or ""
+    if not raw_ext:
+        # No payload at all: nothing identifies an emoji, so treat it as the
+        # image placeholder it almost always is.
+        return ""
+    try:
+        # QQ omits base64 padding; restore it before decoding.
+        decoded = base64.b64decode(raw_ext + "=" * (-len(raw_ext) % 4))
+        label = str(json.loads(decoded.decode("utf-8")).get("text", "") or "").strip()
+    except Exception:
+        return match.group(0)
+    if not label:
+        return ""
+    return f"[表情:{label}]"
+
+
+def strip_qq_face_placeholders(content: Optional[str]) -> str:
+    """Drop image-placeholder face tokens and render real emoji as text.
+
+    Must run before a shared-group ``[name|id]`` prefix is prepended: the
+    caption-less-burst fix identifies that prefix by its position at offset 0
+    (``gateway.run._strip_sender_prefix``), so cleaning the text afterwards
+    would leave the prefix buried mid-string and defeat it.
+    """
+    text = content or ""
+    if "faceType=" not in text:
+        return text.strip()
+
+    # Work line by line: a token often occupies a line of its own, and removing
+    # it in place would leave a blank line the sender never typed. A line that
+    # held nothing but tokens is dropped outright, while blank lines elsewhere
+    # in the message are the sender's own spacing and are left alone.
+    kept = []
+    for line in text.split("\n"):
+        if "faceType=" not in line:
+            kept.append(line)
+            continue
+        cleaned = _FACE_TOKEN_RE.sub(_face_token_replacement, line)
+        cleaned = re.sub(r"[ \t]{2,}", " ", cleaned).strip()
+        if cleaned:
+            kept.append(cleaned)
+    # A caption-less photo has to end up genuinely empty: an all-whitespace
+    # caption still reads as "the sender typed something" downstream.
+    return "\n".join(kept).strip()
+
+
