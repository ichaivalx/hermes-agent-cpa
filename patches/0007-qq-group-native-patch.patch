+def qq_group_file_search(
+    pattern: str,
+    area: str = "workspace",
+    path: str = ".",
+    file_glob: str | None = None,
+    offset: int = 0,
+    limit: int = 50,
+) -> str:
+    """Search file contents inside one current-group area."""
+    try:
+        expression = re.compile(pattern)
+        root = _resolve(area, path, allow_root=True, create=True)
+        area_root = _resolve(area, ".", allow_root=True, create=True)
+        offset = max(0, int(offset))
+        limit = min(500, max(1, int(limit)))
+        if not root.exists():
+            return tool_error("The requested group path does not exist.")
+
+        if root.is_file():
+            candidates = [root]
+        elif root.is_dir():
+            candidates = []
+            for directory, dirnames, filenames in os.walk(root, followlinks=False):
+                current = Path(directory)
+                dirnames[:] = [
+                    name for name in dirnames
+                    if not (current / name).is_symlink()
+                ]
+                dirnames.sort()
+                filenames.sort()
+                candidates.extend(
+                    current / name for name in filenames
+                    if not (current / name).is_symlink()
+                )
+        else:
+            return tool_error("The requested group path is not searchable.")
+
+        matches = []
+        skipped = 0
+        has_more = False
+        for candidate in candidates:
+            relative = candidate.relative_to(area_root).as_posix()
+            if file_glob and not Path(relative).match(file_glob):
+                continue
+            try:
+                with candidate.open("r", encoding="utf-8") as handle:
+                    for line_number, line in enumerate(handle, start=1):
+                        if not expression.search(line):
+                            continue
+                        if skipped < offset:
+                            skipped += 1
+                            continue
+                        if len(matches) >= limit:
+                            has_more = True
+                            break
+                        matches.append({
+                            "path": relative,
+                            "line": line_number,
+                            "content": line.rstrip("\r\n"),
+                        })
+            except (UnicodeDecodeError, OSError):
+                continue
+            if has_more:
+                break
+
+        return tool_result({
+            "success": True,
+            "area": str(area).lower(),
+            "path": str(path),
+            "pattern": pattern,
+            "matches": matches,
+            "offset": offset,
+            "returned": len(matches),
+            "has_more": has_more,
+        })
+    except re.error as exc:
+        return tool_error(f"Invalid regular expression: {exc}")
+    except (GroupWorkspaceError, OSError, ValueError) as exc:
+        return tool_error(str(exc))
+
+
+def qq_group_file_patch(
+    path: str | None = None,
+    old_string: str | None = None,
+    new_string: str | None = None,
+    replace_all: bool = False,
+    patch: str | None = None,
+    mode: str = "replace",
+    *,
+    task_id: str = "default",
+) -> str:
+    """Run Hermes' native replace or V4A patch inside this group only."""
+    try:
+        if mode == "patch":
+            if not isinstance(patch, str) or not patch:
+                return tool_error("patch content required for mode='patch'.")
+            operations, parse_error = parse_v4a_patch(patch)
+            if parse_error:
+                return tool_error(f"Failed to parse patch: {parse_error}")
+            if not operations:
+                return tool_error("Patch contains no file operations.")
+
+            resolved_paths = []
+            for operation in operations:
+                resolved = _resolve(
+                    "workspace", operation.file_path, create=True
+                )
+                operation.file_path = str(resolved)
+                resolved_paths.append(resolved)
+                if operation.new_path:
+                    resolved = _resolve(
+                        "workspace", operation.new_path, create=True
+                    )
+                    operation.new_path = str(resolved)
+                    resolved_paths.append(resolved)
+            workspace = _resolve(
+                "workspace", ".", allow_root=True, create=True
+            )
+            with ExitStack() as locks:
+                for resolved in sorted(set(resolved_paths), key=str):
+                    locks.enter_context(file_state.lock_path(resolved))
+                environment = LocalEnvironment(cwd=str(workspace))
+                try:
+                    result = apply_v4a_operations(
+                        operations,
+                        ShellFileOperations(environment),
+                    )
+                finally:
+                    environment.cleanup()
+            if not result.error:
+                for resolved in resolved_paths:
+                    file_state.note_write(task_id, resolved)
+            return tool_result(result.to_dict())
+
+        if mode != "replace":
+            return tool_error(f"Unknown patch mode: {mode}")
+        if not path:
+            return tool_error("path required for mode='replace'.")
+        if not isinstance(old_string, str) or not isinstance(new_string, str):
+            return tool_error(
+                "old_string and new_string required for mode='replace'."
+            )
+
+        target = _resolve("workspace", path, create=True)
+        if not target.exists():
+            return tool_error("The requested group file does not exist.")
+        if not target.is_file():
+            return tool_error("The requested group path is not a regular file.")
+
+        with file_state.lock_path(target):
+            environment = LocalEnvironment(cwd=str(target.parent))
+            try:
+                result = ShellFileOperations(environment).patch_replace(
+                    str(target),
+                    old_string,
+                    new_string,
+                    bool(replace_all),
+                )
+            finally:
+                environment.cleanup()
+        if not result.error:
+            file_state.note_write(task_id, target)
+        return tool_result(result.to_dict())
+    except (GroupWorkspaceError, OSError, ValueError) as exc:
+        return tool_error(str(exc))
+
