+# QQ's answer when an outbound message quotes no msg_id at all and the bot
+# holds no proactive-push entitlement for that chat. Repeating the send
+# cannot grant the entitlement, and each attempt spends daily push quota,
+# so this fails out immediately and non-retryably.
+_PROACTIVE_DENIED_MARKERS = (
+    "40034102",
+    "主动消息失败",
+)
+
+
+def _is_proactive_push_denied(error_text: str) -> bool:
+    """Return True when an anchorless (proactive) send was refused."""
+    lowered = str(error_text or "").lower()
+    return any(marker in lowered for marker in _PROACTIVE_DENIED_MARKERS)
+
