+@pytest.mark.asyncio
+async def test_router_accepts_only_exact_reply_token():
+    from gateway.platforms.qqbot.group_router import should_reply_to_group_message
+
+    response = SimpleNamespace()
+    with (
+        mock.patch(
+            "agent.auxiliary_client.async_call_llm",
+            new=mock.AsyncMock(return_value=response),
+        ) as call,
+        mock.patch(
+            "agent.auxiliary_client.extract_content_or_reasoning",
+            return_value="REPLY",
+        ),
+    ):
+        result = await should_reply_to_group_message(
+            history=[],
+            current={"sender_name": "Alice", "content": "有人知道吗？"},
+            timeout=2,
