+class _LateSteerDecisionAgent(_SilentDecisionAgent):
+    initialized_prompts = []
+    run_count = 0
+
+    def __init__(self, **kwargs):
+        super().__init__(**kwargs)
+        type(self).initialized_prompts.append(self.ephemeral_system_prompt)
+
+    def run_conversation(self, message, conversation_history=None, **kwargs):
+        type(self).run_count += 1
+        result = super().run_conversation(
