+    @pytest.mark.asyncio
+    async def test_group_attachment_is_stored_under_owning_profile(self, tmp_path):
+        from gateway.platforms.qqbot.adapter import QQAdapter
+        from gateway.platforms.qqbot.group_workspace import group_workspace_paths
+        from hermes_constants import (
+            reset_hermes_home_override,
+            set_hermes_home_override,
+        )
+
+        profile_home = tmp_path / "profile"
+        token = set_hermes_home_override(profile_home)
+        try:
+            adapter = QQAdapter(_make_config(app_id="a", client_secret="b"))
+        finally:
+            reset_hermes_home_override(token)
+
+        cached = tmp_path / "cached.txt"
+        cached.write_text("group attachment", encoding="utf-8")
+
+        async def fake_download(url, content_type, original_name=""):
