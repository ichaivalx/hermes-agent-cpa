+"""QQ group-scoped file access.
+
+This toolset deliberately does not expose Hermes' general ``file`` toolset.
+The trusted request context selects one profile/group directory; model input
+can only choose a path below that directory.
+"""
+
+from __future__ import annotations
+
+import os
+import uuid
+from itertools import islice
+from pathlib import Path
+
+from gateway.platforms.qqbot.group_workspace import (
+    GroupWorkspaceError,
+    resolve_group_path,
+)
+from gateway.session_context import get_session_env
+from hermes_constants import get_hermes_home
+from tools.registry import registry, tool_error, tool_result
+
+
+_GROUP_CHAT_TYPES = {"group", "forum", "channel"}
+
+
+def _current_group() -> tuple[Path, str]:
+    platform = get_session_env("HERMES_SESSION_PLATFORM", "").strip().lower()
+    chat_type = get_session_env("HERMES_SESSION_CHAT_TYPE", "").strip().lower()
+    group_id = get_session_env("HERMES_SESSION_CHAT_ID", "").strip()
+    if platform != "qqbot" or chat_type not in _GROUP_CHAT_TYPES or not group_id:
+        raise GroupWorkspaceError(
+            "QQ group files are only available during a QQ group turn."
+        )
+    return Path(get_hermes_home()), group_id
+
+
+def _resolve(area: str, path: str, *, allow_root: bool = False, create: bool = False) -> Path:
+    profile_home, group_id = _current_group()
+    return resolve_group_path(
+        profile_home,
+        group_id,
+        area,
+        path,
+        allow_root=allow_root,
+        create=create,
+    )
+
+
+def qq_group_file_list(
+    area: str = "workspace",
+    path: str = ".",
+    offset: int = 0,
+    limit: int = 100,
+) -> str:
+    """List one directory inside the current group's isolated storage."""
+    try:
+        directory = _resolve(area, path, allow_root=True, create=True)
+        offset = max(0, int(offset))
+        limit = min(500, max(1, int(limit)))
+        if not directory.exists():
+            return tool_error("The requested group directory does not exist.")
+        if not directory.is_dir():
+            return tool_error("The requested group path is not a directory.")
+
+        entries = []
+        for child in sorted(directory.iterdir(), key=lambda item: item.name.lower()):
+            if child.is_symlink():
+                continue
+            try:
+                stat = child.stat()
+            except OSError:
+                continue
+            entries.append({
+                "name": child.name,
+                "type": "directory" if child.is_dir() else "file",
+                "size": None if child.is_dir() else stat.st_size,
+            })
+        page = entries[offset:offset + limit]
+        return tool_result({
+            "success": True,
+            "area": str(area).lower(),
+            "path": str(path),
+            "entries": page,
+            "offset": offset,
+            "returned": len(page),
+            "total": len(entries),
+            "has_more": offset + len(page) < len(entries),
+        })
+    except (GroupWorkspaceError, OSError, ValueError) as exc:
+        return tool_error(str(exc))
+
+
+def qq_group_file_read(
+    area: str,
+    path: str,
+    offset: int = 1,
+    limit: int = 500,
+    *,
+    task_id: str = "default",
+) -> str:
+    """Read one attachment or workspace file owned by the current group."""
+    try:
+        target = _resolve(area, path, create=True)
+        if not target.exists():
+            return tool_error("The requested group file does not exist.")
+        if not target.is_file():
+            return tool_error("The requested group path is not a regular file.")
+        offset = max(1, int(offset))
+        limit = min(5000, max(1, int(limit)))
+
+        from tools.read_extract import (
+            ExtractionError,
+            MAX_DOCUMENT_BYTES,
+            extract_document_bytes,
+            is_extractable_document,
+        )
+
+        if is_extractable_document(str(target)):
+            if target.stat().st_size > MAX_DOCUMENT_BYTES:
+                return tool_error(
+                    f"Document is larger than the {MAX_DOCUMENT_BYTES:,}-byte extraction limit."
+                )
+            try:
+                text = extract_document_bytes(target.read_bytes(), str(target))
+            except ExtractionError as exc:
+                return tool_error(str(exc))
+            lines = text.splitlines()
+            page = lines[offset - 1:offset - 1 + limit]
+            content = "\n".join(page)
+            has_more = offset - 1 + len(page) < len(lines)
+        else:
+            with target.open("r", encoding="utf-8") as handle:
+                page = list(islice(handle, offset - 1, offset - 1 + limit + 1))
+            has_more = len(page) > limit
+            content = "".join(page[:limit])
+
+        return tool_result({
+            "success": True,
+            "area": str(area).lower(),
+            "path": str(path),
+            "content": content,
+            "offset": offset,
+            "returned": min(len(page), limit),
+            "has_more": has_more,
+        })
+    except UnicodeDecodeError:
+        return tool_error(
+            "The requested file is binary and cannot be returned as UTF-8 text."
+        )
+    except (GroupWorkspaceError, OSError, ValueError) as exc:
+        return tool_error(str(exc))
+
+
+def qq_group_file_write(
+    path: str,
+    content: str,
+    *,
+    task_id: str = "default",
+    session_id: str | None = None,
+) -> str:
+    """Create or replace one text file in the current group's workspace."""
+    if not isinstance(content, str):
+        return tool_error("content must be a string.")
+    try:
+        target = _resolve("workspace", path, create=True)
+        target.parent.mkdir(parents=True, mode=0o700, exist_ok=True)
+        # Re-resolve after creating parents so a pre-existing symlink cannot
+        # become part of the final write path unnoticed.
+        target = _resolve("workspace", str(target), create=True)
+        staging = target.parent / f".{target.name}.{uuid.uuid4().hex}.tmp"
+        try:
+            with staging.open("x", encoding="utf-8", newline="") as handle:
+                handle.write(content)
+                handle.flush()
+                os.fsync(handle.fileno())
+            staging.chmod(0o600)
+            os.replace(staging, target)
+        finally:
+            staging.unlink(missing_ok=True)
+        return tool_result({
+            "success": True,
+            "path": str(path),
+            "bytes_written": len(content.encode("utf-8")),
+        })
+    except (GroupWorkspaceError, OSError, ValueError) as exc:
+        return tool_error(str(exc))
+
+
+QQ_GROUP_FILE_LIST_SCHEMA = {
+    "name": "qq_group_file_list",
+    "description": (
+        "List files owned by the current QQ group. 'incoming' contains "
+        "read-only attachments received from group members; 'workspace' "
+        "contains files the agent may create or replace. This tool cannot "
+        "inspect another group or any path outside these two areas."
+    ),
+    "parameters": {
+        "type": "object",
+        "properties": {
+            "area": {"type": "string", "enum": ["incoming", "workspace"], "default": "workspace"},
+            "path": {"type": "string", "default": "."},
+            "offset": {"type": "integer", "minimum": 0, "default": 0},
+            "limit": {"type": "integer", "minimum": 1, "maximum": 500, "default": 100},
+        },
+        "additionalProperties": False,
+    },
+}
+
+QQ_GROUP_FILE_READ_SCHEMA = {
+    "name": "qq_group_file_read",
+    "description": (
+        "Read a file owned by the current QQ group. Use area='incoming' for "
+        "received attachments and area='workspace' for agent-created files. "
+        "Absolute paths are accepted only when already inside that area."
+    ),
+    "parameters": {
+        "type": "object",
+        "properties": {
+            "area": {"type": "string", "enum": ["incoming", "workspace"]},
+            "path": {"type": "string"},
+            "offset": {"type": "integer", "minimum": 1, "default": 1},
+            "limit": {"type": "integer", "minimum": 1, "default": 500},
+        },
+        "required": ["area", "path"],
+        "additionalProperties": False,
+    },
+}
+
+QQ_GROUP_FILE_WRITE_SCHEMA = {
+    "name": "qq_group_file_write",
+    "description": (
+        "Create or replace a text file in the current QQ group's isolated "
+        "workspace. The destination group is fixed by the inbound request; "
+        "incoming attachments and paths outside the workspace are read-only."
+    ),
+    "parameters": {
+        "type": "object",
+        "properties": {
+            "path": {"type": "string"},
+            "content": {"type": "string"},
+        },
+        "required": ["path", "content"],
+        "additionalProperties": False,
+    },
+}
+
+
+def _handle_list(args, **_kwargs):
+    return qq_group_file_list(
+        area=args.get("area", "workspace"),
+        path=args.get("path", "."),
+        offset=args.get("offset", 0),
+        limit=args.get("limit", 100),
+    )
+
+
+def _handle_read(args, **kwargs):
+    return qq_group_file_read(
+        area=args.get("area", ""),
+        path=args.get("path", ""),
+        offset=args.get("offset", 1),
+        limit=args.get("limit", 500),
+        task_id=kwargs.get("task_id") or "default",
+    )
+
+
+def _handle_write(args, **kwargs):
+    return qq_group_file_write(
+        path=args.get("path", ""),
+        content=args.get("content"),
+        task_id=kwargs.get("task_id") or "default",
+        session_id=kwargs.get("session_id"),
+    )
+
+
+registry.register(
+    name="qq_group_file_list",
+    toolset="qq_group_files",
+    schema=QQ_GROUP_FILE_LIST_SCHEMA,
+    handler=_handle_list,
+    emoji="📁",
+    max_result_size_chars=50_000,
+)
+registry.register(
+    name="qq_group_file_read",
+    toolset="qq_group_files",
+    schema=QQ_GROUP_FILE_READ_SCHEMA,
+    handler=_handle_read,
+    emoji="📖",
+    max_result_size_chars=100_000,
+)
+registry.register(
+    name="qq_group_file_write",
+    toolset="qq_group_files",
+    schema=QQ_GROUP_FILE_WRITE_SCHEMA,
+    handler=_handle_write,
+    emoji="✍️",
+    max_result_size_chars=100_000,
+)

