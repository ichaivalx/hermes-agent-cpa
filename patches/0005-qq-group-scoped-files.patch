+"""Isolation tests for the QQ group-owned file toolset."""
+
+from __future__ import annotations
+
+import json
+from contextlib import contextmanager
+
+import pytest
+
+from gateway.platforms.qqbot.group_workspace import (
+    GroupWorkspaceError,
+    group_workspace_paths,
+    resolve_group_path,
+    store_group_attachment,
+)
+from gateway.session_context import reset_session_vars, set_session_vars
+from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+from tools.qq_group_files_tool import (
+    qq_group_file_list,
+    qq_group_file_read,
+    qq_group_file_write,
+)
+from toolsets import resolve_toolset
+
+
+@contextmanager
+def _group_scope(profile_home, group_id="group-a"):
+    home_token = set_hermes_home_override(profile_home)
+    reset_session_vars()
+    set_session_vars(
+        platform="qqbot",
+        chat_type="group",
+        chat_id=group_id,
+        profile="qq-main",
+        session_key=f"qqbot:{group_id}",
+    )
+    try:
+        yield
+    finally:
+        reset_session_vars()
+        reset_hermes_home_override(home_token)
+
+
+def test_paths_are_isolated_by_profile_and_group(tmp_path):
+    a = group_workspace_paths(tmp_path / "profile-a", "group-a")
+    b = group_workspace_paths(tmp_path / "profile-a", "group-b")
+    c = group_workspace_paths(tmp_path / "profile-b", "group-a")
+
+    assert a.root != b.root
+    assert a.root != c.root
+    assert "group-a" not in str(a.root)
+
+
+def test_toolset_contains_only_scoped_group_file_operations():
+    assert set(resolve_toolset("qq_group_files")) == {
+        "qq_group_file_list",
+        "qq_group_file_read",
+        "qq_group_file_write",
+    }
+
+
+def test_store_attachment_uses_safe_unique_name(tmp_path):
+    source = tmp_path / "cache.bin"
+    source.write_bytes(b"payload")
+
+    stored = store_group_attachment(
+        tmp_path / "profile",
+        "group-a",
+        source,
+        "../../report?.txt",
+    )
+    paths = group_workspace_paths(tmp_path / "profile", "group-a")
+
+    assert stored.parent == paths.incoming
+    assert stored.name.endswith("-report_.txt")
+    assert stored.read_bytes() == b"payload"
+
+
+def test_resolution_rejects_traversal_absolute_escape_and_symlink(tmp_path):
+    profile = tmp_path / "profile"
+    paths = group_workspace_paths(profile, "group-a", create=True)
+    outside = tmp_path / "outside.txt"
+    outside.write_text("secret", encoding="utf-8")
+
+    with pytest.raises(GroupWorkspaceError):
+        resolve_group_path(profile, "group-a", "workspace", "../outside.txt")
+    with pytest.raises(GroupWorkspaceError):
+        resolve_group_path(profile, "group-a", "workspace", str(outside))
+
+    link = paths.workspace / "escape"
+    try:
+        link.symlink_to(tmp_path, target_is_directory=True)
+    except OSError:
+        pytest.skip("Symlink creation is unavailable on this host")
+    with pytest.raises(GroupWorkspaceError):
+        resolve_group_path(profile, "group-a", "workspace", "escape/outside.txt")
+
+
+def test_workspace_root_symlink_is_rejected(tmp_path):
+    profile = tmp_path / "profile"
+    outside = tmp_path / "outside"
+    outside.mkdir()
+    storage_root = profile / "group_workspaces"
+    profile.mkdir()
+    try:
+        storage_root.symlink_to(outside, target_is_directory=True)
+    except OSError:
+        pytest.skip("Symlink creation is unavailable on this host")
+
+    with pytest.raises(GroupWorkspaceError):
+        group_workspace_paths(profile, "group-a", create=True)
+
+
+def test_group_tools_read_write_and_list_only_the_current_group(tmp_path):
+    profile = tmp_path / "profile"
+    with _group_scope(profile, "group-a"):
+        written = json.loads(qq_group_file_write("notes/hello.txt", "hello group"))
+        assert "error" not in written
+
+        listing = json.loads(qq_group_file_list("workspace", "notes"))
+        assert listing["entries"] == [
+            {"name": "hello.txt", "type": "file", "size": 11}
+        ]
+
+        read = qq_group_file_read("workspace", "notes/hello.txt")
+        assert "hello group" in read
+
+    other_paths = group_workspace_paths(profile, "group-b", create=True)
+    other_file = other_paths.workspace / "private.txt"
+    other_file.write_text("other group", encoding="utf-8")
+    with _group_scope(profile, "group-a"):
+        escaped = json.loads(
+            qq_group_file_read("workspace", str(other_file))
+        )
+        assert "outside this group area" in escaped["error"]
+
+
+def test_incoming_is_read_only_and_non_group_context_fails_closed(tmp_path):
+    profile = tmp_path / "profile"
+    paths = group_workspace_paths(profile, "group-a", create=True)
+    incoming = paths.incoming / "input.txt"
+    incoming.write_text("from user", encoding="utf-8")
+
+    with _group_scope(profile):
+        assert "from user" in qq_group_file_read("incoming", "input.txt")
+        result = json.loads(qq_group_file_write(str(incoming), "overwrite"))
+        assert "outside this group area" in result["error"]
+        assert incoming.read_text(encoding="utf-8") == "from user"
+
+    home_token = set_hermes_home_override(profile)
+    reset_session_vars()
+    set_session_vars(platform="qqbot", chat_type="dm", chat_id="user-a")
+    try:
+        result = json.loads(qq_group_file_list())
+        assert "only available during a QQ group turn" in result["error"]
+    finally:
+        reset_session_vars()
+        reset_hermes_home_override(home_token)
