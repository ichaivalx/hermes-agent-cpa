+class TestAnchorlessResendAfterExpiredAnchor:
+    """A refused anchor is dropped and the message is pushed unquoted."""
+
+    def _make_adapter(self):
+        from gateway.platforms.qqbot.adapter import QQAdapter
+        return QQAdapter(_make_config(app_id="a", client_secret="b"))
+
+    def _prepare(self, adapter):
+        adapter._running = True
+        adapter._ws = SimpleNamespace(closed=False)
+        adapter._chat_type_map["group-1"] = "group"
+
+    _EXPIRED = (
+        "QQ Bot API error [400] code=40034031 "
+        "/v2/groups/group-1/messages: msgid已经过期,不能回复"
+    )
+
+    @pytest.mark.asyncio
+    async def test_anchorless_resend_delivers_the_message(self):
+        adapter = self._make_adapter()
+        self._prepare(adapter)
+
+        attempts = []
+
+        async def fake_group_text(group_openid, content, reply_to=None, keyboard=None):
+            from gateway.platforms.base import SendResult
+            attempts.append(reply_to)
+            if reply_to is not None:
+                raise RuntimeError(self._EXPIRED)
+            return SendResult(success=True, message_id="ROBOT1.0_pushed")
+
+        adapter._send_group_text = fake_group_text  # type: ignore[assignment]
+
+        result = await adapter.send("group-1", "visible reply", reply_to="msg-1")
+        assert result.success is True
+        assert result.message_id == "ROBOT1.0_pushed"
+        assert attempts == ["msg-1", None]
+
+    @pytest.mark.asyncio
+    async def test_denied_proactive_push_is_reported_non_retryable(self):
+        """40034102 means the entitlement is missing — stop, don't burn quota."""
+        adapter = self._make_adapter()
+        self._prepare(adapter)
+
+        attempts = []
+
+        async def fake_group_text(group_openid, content, reply_to=None, keyboard=None):
+            attempts.append(reply_to)
+            if reply_to is not None:
+                raise RuntimeError(self._EXPIRED)
+            raise RuntimeError(
+                "QQ Bot API error [400] code=40034102 "
+                "/v2/groups/group-1/messages: 主动消息失败"
+            )
+
+        adapter._send_group_text = fake_group_text  # type: ignore[assignment]
+
+        with mock.patch("asyncio.sleep", new=mock.AsyncMock()):
+            result = await adapter.send("group-1", "visible reply", reply_to="msg-1")
+        assert result.success is False
+        assert result.retryable is False
+        assert "40034031" in (result.error or "")
+        assert "40034102" in (result.error or "")
+        # One anchored attempt, one anchorless attempt. No quota multiplied.
+        assert attempts == ["msg-1", None]
+
+    @pytest.mark.asyncio
+    async def test_no_fallback_when_nothing_was_quoted(self):
+        """Without an anchor there is nothing to drop — do not double-send."""
+        adapter = self._make_adapter()
+        self._prepare(adapter)
+
+        attempts = []
+
+        async def fake_group_text(group_openid, content, reply_to=None, keyboard=None):
+            attempts.append(reply_to)
+            raise RuntimeError(self._EXPIRED)
+
+        adapter._send_group_text = fake_group_text  # type: ignore[assignment]
+
+        result = await adapter.send("group-1", "visible reply")
+        assert result.success is False
+        assert result.retryable is False
+        assert attempts == [None]
+
+    @pytest.mark.asyncio
+    async def test_anchorless_body_carries_no_msg_id(self):
+        """End-to-end proof that the resent request really omits msg_id."""
+        adapter = self._make_adapter()
+        self._prepare(adapter)
+        adapter._http_client = mock.MagicMock()
+        adapter._ensure_token = mock.AsyncMock(return_value="token")
+
+        bodies = []
+
+        async def fake_api_request(method, path, body=None, timeout=None):
+            bodies.append(body)
+            if body and body.get("msg_id"):
+                raise RuntimeError(self._EXPIRED)
+            return {"id": "ROBOT1.0_pushed"}
+
+        adapter._api_request = fake_api_request  # type: ignore[assignment]
+
+        result = await adapter.send("group-1", "visible reply", reply_to="msg-1")
+        assert result.success is True
+        assert len(bodies) == 2
+        assert bodies[0]["msg_id"] == "msg-1"
+        assert "msg_id" not in bodies[1]
