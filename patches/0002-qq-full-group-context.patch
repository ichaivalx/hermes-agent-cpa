@@ -0,0 +1,91 @@
+"""Request-scoped visible delivery for ambient QQ group turns.
+
+The model never supplies a group identifier.  The gateway binds a sender for
+the exact inbound turn, and ordinary finals remain private.  Outside that
+scope the tool fails closed.
+"""
+
+from __future__ import annotations
+
+from contextvars import ContextVar, Token
+from typing import Any, Callable, Dict, Optional
+
+from tools.registry import registry, tool_error, tool_result
+
+
+_CurrentGroupSender = Callable[[str], Dict[str, Any]]
+_current_group_sender: ContextVar[Optional[_CurrentGroupSender]] = ContextVar(
+    "qq_current_group_sender",
+    default=None,
+)
+
+
+def bind_current_group_sender(sender: _CurrentGroupSender) -> Token:
+    """Bind the only QQ group destination available to the current turn."""
+    return _current_group_sender.set(sender)
+
+
+def reset_current_group_sender(token: Token) -> None:
+    """Restore the prior request scope."""
+    _current_group_sender.reset(token)
+
+
+def qq_group_send(message: str) -> str:
+    """Publish one visible message to the current ambient QQ group."""
+    if not isinstance(message, str) or not message.strip():
+        return tool_error("A non-empty message is required.")
+
+    sender = _current_group_sender.get()
+    if sender is None:
+        return tool_error(
+            "qq_group_send is only available during an ambient QQ group turn."
+        )
+
+    try:
+        result = sender(message.strip())
+    except Exception:
+        return tool_error("QQ delivery failed.")
+
+    if not isinstance(result, dict) or result.get("success") is not True:
+        return tool_error(
+            "QQ delivery failed.",
+            retryable=bool(result.get("retryable")) if isinstance(result, dict) else False,
+        )
+
+    payload: Dict[str, Any] = {"success": True}
+    if result.get("message_id"):
+        payload["message_id"] = str(result["message_id"])
+    return tool_result(payload)
+
+
+QQ_GROUP_SEND_SCHEMA = {
+    "name": "qq_group_send",
+    "description": (
+        "Send a visible message to the current QQ group. This is the only "
+        "visible-output path for an ambient (not explicitly @-addressed) QQ "
+        "turn: normal final responses remain private. The destination is "
+        "fixed by the gateway and cannot be selected or changed. Call this "
+        "only when speaking would genuinely improve the conversation. After "
+        "a successful call, do not repeat the same content in your final response."
+    ),
+    "parameters": {
+        "type": "object",
+        "properties": {
+            "message": {
+                "type": "string",
+                "description": "The exact text to post visibly to the current QQ group.",
+            },
+        },
+        "required": ["message"],
+        "additionalProperties": False,
+    },
+}
+
