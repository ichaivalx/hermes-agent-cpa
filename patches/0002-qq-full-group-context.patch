+@pytest.mark.asyncio
+async def test_router_fails_closed_on_explanation_or_exception():
+    from gateway.platforms.qqbot.group_router import should_reply_to_group_message
+
+    response = SimpleNamespace()
+    with (
+        mock.patch(
+            "agent.auxiliary_client.async_call_llm",
+            new=mock.AsyncMock(return_value=response),
+        ),
+        mock.patch(
+            "agent.auxiliary_client.extract_content_or_reasoning",
+            return_value="REPLY because it looks useful",
+        ),
+    ):
+        assert await should_reply_to_group_message(
+            history=[], current={"content": "hello"}, timeout=2
+        ) is False
+
+    with mock.patch(
+        "agent.auxiliary_client.async_call_llm",
+        new=mock.AsyncMock(side_effect=RuntimeError("provider down")),
+    ):
+        assert await should_reply_to_group_message(
+            history=[], current={"content": "hello"}, timeout=2
+        ) is False
+
+
+@pytest.mark.asyncio
+async def test_router_propagates_cancellation():
+    from gateway.platforms.qqbot.group_router import should_reply_to_group_message
+
+    with mock.patch(
+        "agent.auxiliary_client.async_call_llm",
+        new=mock.AsyncMock(side_effect=asyncio.CancelledError()),
+    ):
+        with pytest.raises(asyncio.CancelledError):
