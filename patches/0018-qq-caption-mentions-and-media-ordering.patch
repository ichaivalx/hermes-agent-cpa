+    event = _image_event()
+    runner, _adapter, _handled, session_key = _drive_busy_handler(event, agent)
+
+    agent.steer.assert_called_once()
+    runner._queue_or_replace_pending_event.assert_called_once_with(
+        session_key, event
+    )
+
+
+def test_raising_announce_leaves_the_event_queued():
+    agent = _running_agent()
+    agent.steer = MagicMock(side_effect=RuntimeError("agent gone"))
+    event = _image_event()
+    runner, _adapter, handled, session_key = _drive_busy_handler(event, agent)
+
+    assert handled is True
+    runner._queue_or_replace_pending_event.assert_called_once_with(
+        session_key, event
+    )
+
+
+def test_announced_ack_says_the_attachment_comes_next_turn():
+    agent = _running_agent()
+    event = _image_event()
+    _runner_, adapter, _handled, _sk = _drive_busy_handler(
+        event,
+        agent,
+        cfg={"display": {"platforms": {"qqbot": {"busy_ack_detail": False}}}},
+    )
+
+    adapter._send_with_retry.assert_awaited_once()
+    content = adapter._send_with_retry.await_args.kwargs["content"]
+    # Must be distinguishable from the plain queue ack, which also says
+    # "next turn" but implies the model has heard nothing yet.
+    assert "Noted mid-run" in content
+    assert "attachment" in content
+    assert "Queued for the next turn" not in content
