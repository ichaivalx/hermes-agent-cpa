+            # Not found at-or-after the cursor: fall back to a whole-list
+            # lookup so an out-of-order caller still gets attribution rather
+            # than silently dropping to the event-level sender.
+            try:
+                media_index = media_urls.index(path)
+            except ValueError:
+                media_index = -1
+        seg = owner_by_media_index.get(media_index)
+        if seg is not None:
+            sender = str(seg.get("sender") or "").strip() or event_sender
+            stamp = _format_segment_stamp(seg.get("timestamp")) or event_stamp
+        else:
+            sender = event_sender
+            stamp = event_stamp
+        if sender:
