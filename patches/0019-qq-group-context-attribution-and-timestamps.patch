+def _record_merged_segment(existing: MessageEvent, event: MessageEvent) -> None:
+    """Record one merged message as a self-contained provenance segment.
+
+    ``merge_pending_message_event`` fuses several platform messages into a
+    single pending ``MessageEvent`` so a burst costs one agent turn instead of
+    N.  That is the right cost trade, but the flattening used to destroy three
+    things the model needs in a shared group session:
+
+      * **Who sent which image.** Only ``media_urls`` is extended for a
+        caption-less photo, so the attachment landed in a flat list with no
+        author anywhere near it and the native hint block rendered every path
+        together at the end of the turn.
+      * **When each message was sent.** Only the *first* event object survives
+        (the slot is overwritten only when empty), so every later message's
+        ``timestamp`` was dropped at the moment it was still available.
+      * **Which text belongs to which attachment**, once three senders'
+        captions had been concatenated.
+
+    So capture each contribution here, while the discarded event is still in
+    hand: its own sender label, its own send time, its own text, and the exact
+    slice of ``existing.media_urls`` it contributed.  ``metadata`` is free-form
+    per-event state that the merge otherwise never touches, which makes it the
+    natural carrier — nothing else observes this key.
+
+    MUST be called BEFORE the caller extends ``media_urls`` or merges the
+    caption: the seed segment describes what ``existing`` owned on its own, and
+    the incoming slice is derived from the pre-extend length.  The recorded
+    indices still refer to the post-extend list, so a consumer can map an
+    attachment back to its sender by position alone.
+    """
+    metadata = getattr(existing, "metadata", None)
+    if not isinstance(metadata, dict):
+        return
+    media_len = len(getattr(existing, "media_urls", None) or [])
+    segments = metadata.get(MERGED_SEGMENTS_KEY)
+    if not isinstance(segments, list):
+        # First merge into this slot: seed a segment for the event already
+        # occupying it, or its own text/attachments would be the only
+        # contribution left without provenance.
+        segments = [_segment_for_event(existing, 0, media_len)]
+        metadata[MERGED_SEGMENTS_KEY] = segments
+    incoming_len = len(getattr(event, "media_urls", None) or [])
+    segments.append(
+        _segment_for_event(event, media_len, media_len + incoming_len)
+    )
+
+
+def _segment_for_event(event: MessageEvent, media_start: int, media_end: int) -> Dict[str, Any]:
+    """Build one provenance record for ``event``'s contribution to a merge."""
+    return {
+        "sender": _shared_session_sender_label(event),
+        "timestamp": getattr(event, "timestamp", None),
+        "text": (getattr(event, "text", None) or ""),
+        "media_start": media_start,
+        "media_end": media_end,
+    }
