+
+class TestNativeVisionBatch:
+    """One call, N images.
+
+    Before this, N images meant N serial tool rounds — each one burning a whole
+    model turn and forcing the model to invent a ``question`` it already knew
+    the answer to.
+    """
+
+    def test_image_urls_loads_all_in_one_envelope(self, tmp_path):
+        paths = []
+        for name in ("a.png", "b.png", "c.png"):
+            p = tmp_path / name
+            p.write_bytes(_TINY_PNG)
+            paths.append(str(p))
+
+        result = asyncio.get_event_loop().run_until_complete(
+            _vision_analyze_native(image_urls=paths)
+        )
+        assert isinstance(result, dict) and result.get("_multimodal") is True
+        images = [p for p in result["content"] if p.get("type") == "image_url"]
+        assert len(images) == 3, f"expected 3 image parts, got {len(images)}"
+        assert result["meta"]["image_count"] == 3
+
+        # Exactly one leading text part, and it labels every source in order.
+        texts = [p for p in result["content"] if p.get("type") == "text"]
+        assert len(texts) == 1
+        assert result["content"][0]["type"] == "text"
+        label = texts[0]["text"]
+        assert label.index(paths[0]) < label.index(paths[1]) < label.index(paths[2])
+
+    def test_no_question_required(self, tmp_path):
+        """The whole point: loading images takes no question at all."""
+        img = tmp_path / "x.png"
+        img.write_bytes(_TINY_PNG)
+        result = asyncio.get_event_loop().run_until_complete(
+            _vision_analyze_native(str(img))
+        )
+        assert isinstance(result, dict) and result.get("_multimodal") is True
+
+    def test_partial_failure_still_delivers_good_images(self, tmp_path):
+        good = tmp_path / "good.png"
+        good.write_bytes(_TINY_PNG)
+        missing = str(tmp_path / "nope.png")
+
+        result = asyncio.get_event_loop().run_until_complete(
+            _vision_analyze_native(image_urls=[str(good), missing])
+        )
+        assert isinstance(result, dict) and result.get("_multimodal") is True
+        images = [p for p in result["content"] if p.get("type") == "image_url"]
+        assert len(images) == 1
+        assert "nope.png" in result["content"][0]["text"]
+        assert result["meta"]["errors"]
+
+    def test_all_failures_return_error_string(self, tmp_path):
+        result = asyncio.get_event_loop().run_until_complete(
+            _vision_analyze_native(image_urls=[str(tmp_path / "a.png")])
+        )
