+    def test_markers_carry_no_underscore(self):
+        """Matching strips underscores, so a marker holding one can never hit.
+
+        QQ spells the same field ``msgid`` under one code and ``msg_id``
+        under another. _is_expired_reply_anchor() removes underscores from
+        the error text to collapse both; a marker written with one would be
+        dead on arrival, which is exactly the bug this guards against.
+        """
+        from gateway.platforms.qqbot.adapter import _ANCHOR_EXPIRED_MARKERS
+
+        offenders = [m for m in _ANCHOR_EXPIRED_MARKERS if "_" in m]
+        assert not offenders, f"markers can never match: {offenders}"
 
