+def test_native_multimodal_parts_convert_video_data_url_to_inline_data():
+    from agent.gemini_native_adapter import _extract_multimodal_parts
+
+    payload = b"fake-mp4-payload"
+    encoded = base64.b64encode(payload).decode("ascii")
+
+    parts = _extract_multimodal_parts(
+        [
+            {"type": "text", "text": "Describe this video"},
+            {
+                "type": "video_url",
+                "video_url": {"url": f"data:video/mp4;base64,{encoded}"},
+            },
+        ]
+    )
+
+    assert parts == [
+        {"text": "Describe this video"},
+        {
+            "inlineData": {
+                "mimeType": "video/mp4",
+                "data": encoded,
+            }
+        },
+    ]
+
