+    @pytest.mark.asyncio
+    @pytest.mark.parametrize(
+        ("content", "marker"),
+        [
+            ("<@bot-openid> /new", {"bot": True}),
+            ("<@bot-openid>/new", {"is_you": "true"}),
+        ],
+    )
+    async def test_full_structured_bot_mention_preserves_gateway_command(
+        self, content, marker
+    ):
+        adapter = self._make(mode="direct")
+        adapter._session_store = _QQGroupStore()
+        adapter.handle_message = mock.AsyncMock()
+        payload = self._payload(
+            content=content,
+            mentions=[{"id": "bot-openid", **marker}],
+        )
+
+        await adapter._on_message("GROUP_MESSAGE_CREATE", payload)
+
+        event = adapter.handle_message.await_args.args[0]
+        assert event.text == "/new"
+        assert event.is_command() is True
+        assert event.metadata["shared_group_session"] is False
+
+    @pytest.mark.asyncio
+    async def test_structured_human_mention_is_not_gateway_command(self):
+        adapter = self._make(mode="direct")
+        adapter._session_store = _QQGroupStore()
+        adapter.handle_message = mock.AsyncMock()
+        payload = self._payload(
+            content="<@human-openid> /new",
+            mentions=[{"id": "human-openid"}],
+        )
+
+        await adapter._on_message("GROUP_AT_MESSAGE_CREATE", payload)
+
+        event = adapter.handle_message.await_args.args[0]
+        assert "<@human-openid> /new" in event.text
+        assert event.is_command() is False
+        assert event.metadata["shared_group_session"] is True
