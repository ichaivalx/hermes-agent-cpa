diff --git a/tests/gateway/test_qq_media_mention_and_ordering.py b/tests/gateway/test_qq_media_mention_and_ordering.py
new file mode 100644
index 0000000..9b01de9
--- /dev/null
+++ b/tests/gateway/test_qq_media_mention_and_ordering.py
@@ -0,0 +1,546 @@
+"""QQ media: caption mentions split out, and mid-turn arrival is announced.
+
+Two defects with one shared cause -- a media message's caption is a plain
+``content`` field, not rich text:
+
+1. ``<@openid>`` in an image caption renders as a literal system ID because
+   only markdown (``msg_type`` 2) parses mentions, and ``msg_type`` is a single
+   mutually-exclusive field. The mention has to leave the caption to work.
+2. A non-voice attachment cannot steer, so it queues while later text steers in
+   ahead of it -- the image then surfaces after the turn's tools finished, with
+   no hint of when it was actually sent or by whom.
+"""
+
+import asyncio
+from datetime import datetime, timezone
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock, patch
+
+import gateway.run as gateway_run
+from gateway.config import Platform
+from gateway.platforms.base import MessageEvent, MessageType, SendResult
+from gateway.platforms.qqbot.adapter import QQAdapter, split_caption_mentions
+from gateway.session import SessionSource
+
+
+# ---------------------------------------------------------------------------
+# 1. Caption mention splitting (pure function)
+# ---------------------------------------------------------------------------
+
+
+def test_caption_without_mention_is_untouched():
+    assert split_caption_mentions("just a caption") == ("", "just a caption")
+    assert split_caption_mentions("") == ("", "")
+    assert split_caption_mentions(None) == ("", "")
+
+
+def test_mention_is_extracted_and_prose_stays_with_media():
+    mention, caption = split_caption_mentions("<@ABC123> look at this")
+    assert mention == "<@ABC123>"
+    assert caption == "look at this"
+
+
+def test_mention_with_bang_prefix_is_extracted():
+    mention, caption = split_caption_mentions("<@!ABC123> hi")
+    assert mention == "<@!ABC123>"
+    assert caption == "hi"
+
+
+def test_multiple_mentions_are_deduplicated_in_order():
+    mention, caption = split_caption_mentions("<@BBB> <@AAA> text <@BBB> more")
+    assert mention == "<@BBB> <@AAA>"
+    assert caption == "text more"
+
+
+def test_mention_only_caption_leaves_media_uncaptioned():
+    mention, caption = split_caption_mentions("<@ABC123>")
+    assert mention == "<@ABC123>"
+    assert caption == ""
+
+
+def test_mention_on_its_own_line_does_not_leave_a_blank_line():
+    mention, caption = split_caption_mentions("<@ABC123>\n\nbody text")
+    assert mention == "<@ABC123>"
+    assert caption == "body text"
+
+
+# ---------------------------------------------------------------------------
+# 2. Adapter wiring: the split-out mention goes out as its own text message
+# ---------------------------------------------------------------------------
+
+
+def _adapter():
+    """A QQAdapter with only the collaborators ``_send_media`` touches."""
+    adapter = QQAdapter.__new__(QQAdapter)
+    adapter._markdown_support = True
+    adapter._app_id = "test-app"
+    adapter.MAX_MESSAGE_LENGTH = 4000
+    # is_connected is derived, so satisfy it rather than assigning to it.
+    adapter._running = True
+    adapter._ws = SimpleNamespace(closed=False)
+    adapter._next_msg_seq = MagicMock(return_value=1)
+    adapter._guess_chat_type = MagicMock(return_value="group")
+    adapter._is_url = MagicMock(return_value=False)
+    adapter._upload_local_file = AsyncMock(
+        return_value=("img.png", {"file_info": "TOKEN"})
+    )
+    adapter._api_request = AsyncMock(return_value={"id": "sent-1"})
+    adapter.send = AsyncMock(return_value=SendResult(success=True))
+    return adapter
+
+
+def _send_media(adapter, caption):
+    return asyncio.run(
+        adapter._send_media(
+            "group-1", "/tmp/img.png", 1, "image", caption, "anchor-1"
+        )
+    )
+
+
+def _posted_body(adapter):
+    return adapter._api_request.await_args.args[2]
+
+
+def test_group_caption_mention_is_sent_as_its_own_message():
+    adapter = _adapter()
+    result = _send_media(adapter, "<@ABC123> look")
+
+    assert result.success
+    adapter.send.assert_awaited_once()
+    kwargs = adapter.send.await_args.kwargs
+    assert kwargs["content"] == "<@ABC123>"
+    # Both messages quote the same anchor.
+    assert kwargs["reply_to"] == "anchor-1"
+
+    # The remaining prose still rides with the image, mention stripped.
+    body = _posted_body(adapter)
+    assert body["content"] == "look"
+    assert "<@ABC123>" not in body["content"]
+
+
+def test_caption_without_mention_sends_no_extra_message():
+    adapter = _adapter()
+    result = _send_media(adapter, "plain caption")
+
+    assert result.success
+    adapter.send.assert_not_awaited()
+    assert _posted_body(adapter)["content"] == "plain caption"
+
+
+def test_dm_caption_mention_is_left_alone():
+    adapter = _adapter()
+    adapter._guess_chat_type = MagicMock(return_value="c2c")
+
+    assert _send_media(adapter, "<@ABC123> hi").success
+    adapter.send.assert_not_awaited()
+    assert _posted_body(adapter)["content"] == "<@ABC123> hi"
+
+
+def test_markdown_disabled_leaves_caption_alone():
+    # With markdown off the text path emits msg_type 0, which does not parse
+    # mentions either -- splitting would add a message and fix nothing.
+    adapter = _adapter()
+    adapter._markdown_support = False
+
+    assert _send_media(adapter, "<@ABC123> hi").success
+    adapter.send.assert_not_awaited()
+    assert _posted_body(adapter)["content"] == "<@ABC123> hi"
+
+
+def test_failed_mention_message_still_delivers_the_media():
+    adapter = _adapter()
+    adapter.send = AsyncMock(
+        return_value=SendResult(success=False, error="boom")
+    )
+
+    result = _send_media(adapter, "<@ABC123> look")
+
+    assert result.success
+    assert _posted_body(adapter)["content"] == "look"
+
+
+def test_raising_mention_message_still_delivers_the_media():
+    adapter = _adapter()
+    adapter.send = AsyncMock(side_effect=RuntimeError("network"))
+
+    result = _send_media(adapter, "<@ABC123> look")
+
+    assert result.success
+    assert _posted_body(adapter)["content"] == "look"
+
+
+def test_mention_only_caption_posts_media_without_content():
+    adapter = _adapter()
+
+    assert _send_media(adapter, "<@ABC123>").success
+    assert adapter.send.await_args.kwargs["content"] == "<@ABC123>"
+    assert "content" not in _posted_body(adapter)
+
+
+# ---------------------------------------------------------------------------
+# 3. Inbound placeholder names its sender
+# ---------------------------------------------------------------------------
+
+
+_PHOTO_PATH = "/incoming/ab12cd34ef56-photo.png"
+
+
+def _image_event(**kwargs):
+    defaults = dict(
+        text="",
+        message_type=MessageType.PHOTO,
+        media_urls=[_PHOTO_PATH],
+        media_types=["image/png"],
+        user_name="chidori",
+        user_id="B099F32B",
+        source=SessionSource(
+            platform=Platform.QQBOT,
+            chat_id="group-1",
+            chat_type="group",
+            user_id="B099F32B",
+            user_name="chidori",
+        ),
+    )
+    defaults.update(kwargs)
+    return MessageEvent(**defaults)
+
+
+def test_placeholder_names_the_group_sender():
+    text = gateway_run._build_media_placeholder(_image_event())
+    assert text == f"[chidori|B099F32B sent an image: {_PHOTO_PATH}]"
+    # The old wording said an anonymous "User" even in a multi-party group.
+    assert "User sent" not in text
+
+
+def test_placeholder_falls_back_to_source_identity():
+    event = _image_event(user_name=None, user_id=None)
+    assert "chidori|B099F32B" in gateway_run._build_media_placeholder(event)
+
+
+def test_placeholder_without_identity_keeps_the_old_wording():
+    """No author => byte-identical to the pre-change text."""
+    event = _image_event(user_name=None, user_id=None, source=None)
+    text = gateway_run._build_media_placeholder(event)
+    assert text == f"[User sent an image: {_PHOTO_PATH}]"
+
+
+def test_placeholder_labels_each_media_kind():
+    cases = {
+        "audio/ogg": "sent audio",
+        "video/mp4": "sent a video",
+        "application/pdf": "sent a file",
+    }
+    for mime, label in cases.items():
+        event = _image_event(media_types=[mime])
+        assert label in gateway_run._build_media_placeholder(event)
+
+
+def test_placeholder_path_is_the_string_the_native_turn_will_show():
+    """Correlation is exact, not guessed: both sides read media_urls[i].
+
+    The native multimodal message carries only base64 pixels, so the only path
+    the model ever sees is the hint line ``agent.image_routing`` appends beside
+    them -- built from this same list.
+    """
+    import agent.image_routing as image_routing
+
+    event = _image_event()
+    path = event.media_urls[0]
+
+    placeholder = gateway_run._build_media_placeholder(event)
+    assert path in placeholder
+
+    with patch.object(image_routing.Path, "exists", return_value=True), \
+            patch.object(image_routing.Path, "is_file", return_value=True), \
+            patch.object(
+                image_routing,
+                "_file_to_data_url",
+                return_value="data:image/png;base64,AAAA",
+            ):
+        parts, _skipped = image_routing.build_native_content_parts(
+            "caption", [path]
+        )
+
+    hint = parts[0]["text"]
+    assert f"[Image attached at: {path}]" in hint
+    # And the pixels themselves carry no path at all -- hence the hint.
+    assert parts[1]["image_url"]["url"].startswith("data:image/")
+
+
+# ---------------------------------------------------------------------------
