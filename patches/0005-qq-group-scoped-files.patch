index 000000000..702f8ee31
--- /dev/null
+++ b/gateway/platforms/qqbot/group_workspace.py
@@ -0,0 +1,170 @@
+"""Path isolation for QQ group-owned attachments and working files.
+
+The group identifier is never accepted from a model tool call.  Both the
+adapter and the tool layer derive the same opaque directory from the trusted
+inbound chat id and the active profile home.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import os
+import shutil
+import uuid
+from dataclasses import dataclass
+from pathlib import Path
+
+
+class GroupWorkspaceError(ValueError):
+    """Raised when a requested path leaves its group-owned area."""
+
+
+@dataclass(frozen=True)
+class GroupWorkspacePaths:
+    root: Path
+    incoming: Path
+    workspace: Path
+
+
+def group_workspace_paths(
+    profile_home: Path | str,
+    group_id: str,
+    *,
+    create: bool = False,
+) -> GroupWorkspacePaths:
+    """Return the deterministic, profile-scoped paths for one QQ group."""
+    normalized_group_id = str(group_id or "").strip()
+    if not normalized_group_id:
+        raise GroupWorkspaceError("A trusted QQ group id is required.")
+
+    digest = hashlib.sha256(normalized_group_id.encode("utf-8")).hexdigest()[:32]
+    profile_root = Path(profile_home).expanduser().resolve(strict=False)
+    storage_root = profile_root / "group_workspaces"
+    root = storage_root / f"qq-{digest}"
+    paths = GroupWorkspacePaths(
+        root=root,
+        incoming=root / "incoming",
+        workspace=root / "workspace",
+    )
+    for directory in (storage_root, paths.root, paths.incoming, paths.workspace):
+        if directory.is_symlink():
+            raise GroupWorkspaceError("Symlinks are not allowed in group workspace roots.")
+        if create:
+            directory.mkdir(parents=True, mode=0o700, exist_ok=True)
+            if directory.is_symlink():
+                raise GroupWorkspaceError(
+                    "Symlinks are not allowed in group workspace roots."
+                )
+    return paths
+
+
+def _safe_attachment_name(name: str, fallback: str) -> str:
+    raw = str(name or "").replace("\\", "/")
+    basename = raw.rsplit("/", 1)[-1].strip()
+    if not basename:
+        basename = fallback
+    safe = "".join(
+        char if char.isalnum() or char in {" ", ".", "_", "-", "(", ")"} else "_"
+        for char in basename
+    ).strip(" .")
+    if not safe:
+        safe = fallback
+    if safe.startswith("."):
+        safe = f"attachment{safe}"
+    return safe[:160]
+
+
+def store_group_attachment(
+    profile_home: Path | str,
+    group_id: str,
+    source_path: Path | str,
+    original_name: str = "",
+) -> Path:
+    """Link or copy one cached inbound file into the group's read-only area."""
+    source_input = Path(source_path).expanduser()
+    if source_input.is_symlink():
+        raise GroupWorkspaceError("Symlink attachments are not allowed.")
+    source = source_input.resolve(strict=True)
+    if not source.is_file():
+        raise GroupWorkspaceError("Only regular cached files can be stored.")
+
+    paths = group_workspace_paths(profile_home, group_id, create=True)
+    safe_name = _safe_attachment_name(original_name, source.name or "attachment")
+
+    for _ in range(4):
+        destination = paths.incoming / f"{uuid.uuid4().hex[:12]}-{safe_name}"
+        try:
+            os.link(source, destination)
+            return destination
+        except FileExistsError:
+            continue
+        except OSError:
+            staging = paths.root / f".incoming-{uuid.uuid4().hex}.tmp"
+            try:
+                with source.open("rb") as src, staging.open("xb") as dst:
+                    shutil.copyfileobj(src, dst)
+                shutil.copystat(source, staging, follow_symlinks=False)
+                os.replace(staging, destination)
+                return destination
+            except FileExistsError:
+                continue
+            except Exception:
+                raise
+            finally:
+                staging.unlink(missing_ok=True)
+    raise GroupWorkspaceError("Could not allocate a unique attachment path.")
+
+
+def resolve_group_path(
+    profile_home: Path | str,
+    group_id: str,
+    area: str,
+    requested_path: str,
+    *,
+    allow_root: bool = False,
+    create: bool = False,
+) -> Path:
+    """Resolve a model-supplied path inside one trusted group area.
+
+    Absolute paths are accepted only when they already point inside the chosen
+    group area.  Traversal and symlink components are rejected before any file
+    operation is attempted.
+    """
+    paths = group_workspace_paths(profile_home, group_id, create=create)
+    areas = {"incoming": paths.incoming, "workspace": paths.workspace}
+    base = areas.get(str(area or "").strip().lower())
+    if base is None:
+        raise GroupWorkspaceError("area must be 'incoming' or 'workspace'.")
+
+    value = str(requested_path or "").strip()
+    if not value:
+        if allow_root:
+            return base.resolve(strict=False)
+        raise GroupWorkspaceError("A non-empty path is required.")
+    if "\x00" in value:
+        raise GroupWorkspaceError("NUL bytes are not allowed in paths.")
+
+    raw = Path(value)
+    if ".." in raw.parts:
+        raise GroupWorkspaceError("Parent-directory traversal is not allowed.")
+    candidate = raw if raw.is_absolute() else base / raw
+    base_resolved = base.resolve(strict=False)
+    candidate_resolved = candidate.resolve(strict=False)
+    try:
+        candidate_resolved.relative_to(base_resolved)
+    except ValueError as exc:
+        raise GroupWorkspaceError("The requested path is outside this group area.") from exc
+
+    try:
+        lexical_relative = candidate.relative_to(base)
+    except ValueError as exc:
+        raise GroupWorkspaceError("The requested path is outside this group area.") from exc
+    cursor = base
+    for part in lexical_relative.parts:
+        cursor = cursor / part
+        if cursor.is_symlink():
+            raise GroupWorkspaceError("Symlinks are not allowed in group paths.")
+
+    if not allow_root and candidate_resolved == base_resolved:
+        raise GroupWorkspaceError("A file path below the group area is required.")
+    return candidate_resolved
