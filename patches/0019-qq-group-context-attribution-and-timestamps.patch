+# ``event.metadata`` key carrying per-contribution provenance for a pending
+# event that ``merge_pending_message_event`` fused from several platform
+# messages.  Read by ``gateway.run`` when it renders the merged turn, so the
+# model sees "who sent what, when" instead of a flattened blob.  Nothing else
+# in the codebase observes this key.
+MERGED_SEGMENTS_KEY = "merged_message_segments"
