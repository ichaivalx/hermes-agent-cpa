+# A structured group mention as the model is told to write it (SOUL/profile
+# guidance: put ``<@openid>`` in the reply text and QQ turns it into a real
+# mention). QQ only parses this inside a markdown body (``msg_type`` 2); a
+# media message (``msg_type`` 7) carries its caption in a plain ``content``
+# field with no rich-text parsing, so the same string renders as the literal
+# characters "<@B099F32B...>" — a raw system ID in the group.
+_STRUCTURED_MENTION_RE = re.compile(r"<@!?[A-Za-z0-9_\-]{2,128}>")
+
+
+def split_caption_mentions(caption: Optional[str]) -> Tuple[str, str]:
+    """Split a media caption into (mention_message, remaining_caption).
+
+    ``msg_type`` is a single mutually-exclusive field, so one QQ message is
+    either markdown or media — never both. An image caption therefore cannot
+    contain a parsed mention, and there is no way to merge the two into one
+    message. Extracting the mentions into their own text message (which does
+    go out as markdown) is the only way to make them render as real mentions.
+
+    Only the mention tokens move. Any surrounding prose stays with the media
+    so the picture keeps its caption, matching the agreed behaviour: the
+    mention becomes its own message, everything else rides along with the
+    image.
+
+    Returns ``("", caption)`` unchanged when the caption holds no structured
+    mention, so the common case is untouched and cannot regress.
+    """
+    text = caption or ""
+    if not text.strip():
+        return "", text
+
+    mentions = _STRUCTURED_MENTION_RE.findall(text)
+    if not mentions:
+        return "", text
+
+    remainder = _STRUCTURED_MENTION_RE.sub(" ", text)
+    # Collapse only the whitespace the removal introduced: runs of spaces and
+    # tabs, plus blank lines left behind when a mention occupied its own line.
+    remainder = re.sub(r"[ \t]{2,}", " ", remainder)
+    remainder = re.sub(r"[ \t]+(\r?\n)", r"\1", remainder)
+    remainder = re.sub(r"(\r?\n)[ \t]+", r"\1", remainder)
+    remainder = re.sub(r"(\r?\n){3,}", "\n\n", remainder)
+
+    # Deduplicate while preserving order: the same person mentioned twice in
+    # one caption should not be pinged twice in the split-out message.
+    seen: set = set()
+    ordered: List[str] = []
+    for mention in mentions:
+        if mention not in seen:
+            seen.add(mention)
+            ordered.append(mention)
+
+    return " ".join(ordered), remainder.strip()
+
+
