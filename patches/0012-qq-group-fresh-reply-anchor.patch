+# ---------------------------------------------------------------------------
+# Reply-anchor freshness and expiry classification
+# ---------------------------------------------------------------------------
+
+class TestLatestReplyAnchor:
+    """QQ expires a quoted msg_id, so senders must re-read the newest one."""
+
+    def _make_adapter(self):
+        from gateway.platforms.qqbot.adapter import QQAdapter
+        return QQAdapter(_make_config(app_id="a", client_secret="b"))
+
+    def test_returns_none_without_inbound_traffic(self):
+        adapter = self._make_adapter()
+        assert adapter.latest_reply_anchor("group-1") is None
+        assert adapter.latest_reply_anchor("") is None
+        assert adapter.latest_reply_anchor(None) is None
+
+    def test_returns_the_newest_inbound_id_for_that_chat(self):
+        adapter = self._make_adapter()
+        adapter._last_msg_id["group-1"] = "msg-1"
+        adapter._last_msg_id["group-2"] = "other-1"
+        assert adapter.latest_reply_anchor("group-1") == "msg-1"
+
+        adapter._last_msg_id["group-1"] = "msg-9"
+        assert adapter.latest_reply_anchor("group-1") == "msg-9"
+        assert adapter.latest_reply_anchor("group-2") == "other-1"
+
+    @pytest.mark.asyncio
+    async def test_handle_message_refreshes_the_anchor(self):
+        from gateway.platforms.base import MessageEvent, MessageType
+
+        adapter = self._make_adapter()
+        # No message handler is installed, so the base class returns right
+        # after this override has recorded the anchor — which is exactly the
+        # behaviour under test.
+        source = adapter.build_source(
+            chat_id="group-1", chat_type="group", user_id="member-1",
+        )
+        for message_id in ("msg-1", "msg-2", "msg-3"):
+            await adapter.handle_message(MessageEvent(
+                source=source,
+                text="ordinary chatter",
+                message_type=MessageType.TEXT,
+                message_id=message_id,
+            ))
+        assert adapter.latest_reply_anchor("group-1") == "msg-3"
+
+
+class TestExpiredReplyAnchorIsNotRetryable:
+    """An expired anchor cannot be fixed by resending the same msg_id."""
+
+    def _make_adapter(self):
+        from gateway.platforms.qqbot.adapter import QQAdapter
+        return QQAdapter(_make_config(app_id="a", client_secret="b"))
+
+    def test_marker_detection(self):
+        from gateway.platforms.qqbot.adapter import _is_expired_reply_anchor
+
+        assert _is_expired_reply_anchor(
+            "QQ Bot API error [400] code=304027 /v2/groups/g/messages: "
+            "msg_id expire"
+        )
+        assert _is_expired_reply_anchor("MSG_EXPIRE")
+        assert not _is_expired_reply_anchor("QQ Bot API timeout")
+        assert not _is_expired_reply_anchor("")
+
+    @pytest.mark.asyncio
+    async def test_send_reports_expired_anchor_without_retrying(self):
+        adapter = self._make_adapter()
+        adapter._running = True
+        adapter._ws = SimpleNamespace(closed=False)
+        adapter._chat_type_map["group-1"] = "group"
+
+        attempts = []
+
+        async def fake_group_text(group_openid, content, reply_to=None, keyboard=None):
+            attempts.append(reply_to)
+            raise RuntimeError(
+                "QQ Bot API error [400] code=304027 "
+                "/v2/groups/group-1/messages: msg_id expire"
+            )
+
+        adapter._send_group_text = fake_group_text  # type: ignore[assignment]
+
+        result = await adapter.send("group-1", "visible reply", reply_to="msg-1")
+        assert result.success is False
+        assert result.retryable is False
+        assert "304027" in (result.error or "")
+        # One attempt only — no exponential-backoff retries of a dead anchor.
+        assert attempts == ["msg-1"]
+
+    @pytest.mark.asyncio
+    async def test_transient_errors_stay_retryable(self):
+        adapter = self._make_adapter()
+        adapter._running = True
+        adapter._ws = SimpleNamespace(closed=False)
+        adapter._chat_type_map["group-1"] = "group"
+
+        attempts = []
+
+        async def fake_group_text(group_openid, content, reply_to=None, keyboard=None):
+            attempts.append(reply_to)
+            raise RuntimeError("QQ Bot API timeout [/v2/groups/group-1/messages]")
+
+        adapter._send_group_text = fake_group_text  # type: ignore[assignment]
+
+        with mock.patch("asyncio.sleep", new=mock.AsyncMock()):
+            result = await adapter.send("group-1", "visible reply", reply_to="msg-1")
+        assert result.success is False
+        assert result.retryable is True
+        assert len(attempts) == 3
