+    Returns ``[]`` when no sender is resolvable at all, which keeps the plain
+    ``[Image attached at: <path>]`` layout for DMs and non-group platforms.
+    """
+    if not image_paths:
+        return []
+
+    media_urls = list(getattr(event, "media_urls", None) or [])
+    segments = _event_merged_segments(event)
+    # Map each media index to its owning segment so an image can be traced
+    # back to one original message rather than to the merged whole.
+    owner_by_media_index: Dict[int, Dict[str, Any]] = {}
+    for seg in segments:
+        try:
+            start = int(seg.get("media_start") or 0)
+            end = int(seg.get("media_end") or 0)
+        except (TypeError, ValueError):
+            continue
+        for idx in range(max(start, 0), min(end, len(media_urls))):
+            owner_by_media_index[idx] = seg
