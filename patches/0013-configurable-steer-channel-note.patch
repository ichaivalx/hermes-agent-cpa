+def resolve_steer_channel_note(agent_section) -> Optional[str]:
+    """Resolve ``agent.steer_channel_note`` from config into a note override.
+
+    Three states, matching the convention the QQ group prompts and tool
+    descriptions already use:
+
+    - key absent       -> ``None``: keep the built-in STEER_CHANNEL_NOTE
+    - non-empty string -> that text replaces the built-in note
+    - ``""``           -> no note is injected at all
+
+    Why this is configurable: the built-in wording tells the model that
+    marker content carries "the same authority as their original request".
+    That is right for a 1:1 session, where the only sender is the user.
+    A shared multi-party session (a QQ group with busy_input_mode: steer)
+    routes ordinary chatter from any participant through the same marker,
+    so the built-in text promotes a bystander's remark to a command and
+    fights a Profile's own "decide for yourself whether to answer" persona.
+    Operators need to reword it without forking the image.
+
+    ``""`` is a deliberate footgun and not the fix for that: the marker
+    itself still shows up in tool results, and an unexplained marker gets
+    refused as suspected prompt injection (see the module note above).
+    Prefer replacing the text over dropping it.
+    """
+    if not isinstance(agent_section, dict):
+        return None
+    if "steer_channel_note" not in agent_section:
+        return None
+    value = agent_section["steer_channel_note"]
+    if not isinstance(value, str):
+        logger.warning(
+            "Ignoring non-string agent.steer_channel_note (%s); using the "
+            "built-in mid-turn steering note",
+            type(value).__name__,
+        )
+        return None
+    return value.strip()
+
