+
+def _shared_session_sender_label(event: MessageEvent) -> str:
+    """Return ``name|id`` for a shared-group event's author, else "".
+
+    Mirrors ``gateway.run._event_sender_label`` but lives here so the merge
+    choke point below does not have to import from the runner (which imports
+    *this* module).  Prefers the event's own author fields, then ``source``.
+    """
+    for holder in (event, getattr(event, "source", None)):
+        if holder is None:
+            continue
+        name = str(getattr(holder, "user_name", None) or "").strip()
+        user_id = str(getattr(holder, "user_id", None) or "").strip()
+        if name and user_id:
