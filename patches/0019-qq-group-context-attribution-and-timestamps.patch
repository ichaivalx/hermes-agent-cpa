+def _event_merged_segments(event) -> List[Dict[str, Any]]:
+    """Return the provenance segments recorded when this event was merged.
+
+    ``merge_pending_message_event`` fuses a burst of platform messages into one
+    pending event and records what each contributed under
+    ``metadata[MERGED_SEGMENTS_KEY]`` (see ``gateway.platforms.base``). Absent
+    for an unmerged event — the caller then treats the whole event as one
+    segment.
+    """
+    metadata = getattr(event, "metadata", None)
+    if not isinstance(metadata, dict):
+        return []
+    segments = metadata.get(MERGED_SEGMENTS_KEY)
+    if not isinstance(segments, list):
+        return []
+    return [seg for seg in segments if isinstance(seg, dict)]
+
+
+def _format_segment_stamp(ts_value) -> str:
+    """Format one segment's send time, or "" when it can't be resolved."""
+    try:
+        from hermes_time import get_timezone as _get_seg_tz
+        from gateway.message_timestamps import (
+            format_message_timestamp as _fmt_seg_ts,
+        )
+        return _fmt_seg_ts(ts_value, tz=_get_seg_tz())
+    except Exception:
+        return ""
+
+
+def _build_merged_event_text(event) -> Optional[str]:
+    """Re-expand a merged pending event into per-sender, per-time blocks.
+
+    A merged event's own ``text`` is the concatenation
+    ``_merge_caption`` produced, which in a shared group session reads as one
+    speaker's monologue: every sender's ``[name|id]`` prefix is stacked in one
+    blob, and only the FIRST event's ``timestamp`` survived the merge (the slot
+    object is reused). The model cannot recover the boundaries from that.
+
+    Rebuild the text from the recorded segments instead, one block per original
+    message, each opening with its own timestamp so temporal order is explicit
+    rather than inferred from position. Media is NOT named here — the native
+    attachment path carries per-image attribution adjacent to the pixels (see
+    ``_build_native_image_labels``), and repeating the paths in the text would
+    double-count every photo.
+
+    Returns ``None`` when there is nothing to re-expand (unmerged event, or
+    fewer than two segments), so callers keep the existing single-message path.
+    """
+    segments = _event_merged_segments(event)
+    if len(segments) < 2:
+        return None
+
+    blocks: List[str] = []
+    for seg in segments:
+        seg_text = str(seg.get("text") or "").strip()
+        stamp = _format_segment_stamp(seg.get("timestamp"))
+        sender = str(seg.get("sender") or "").strip()
+        # Guard the span the same way ``_build_native_image_labels`` does: a
+        # segment is plain dict data that survives a persist/replay round trip,
+        # so a non-numeric span must degrade to "no media" rather than raise
+        # and take the whole message down.
+        try:
+            media_count = max(
+                int(seg.get("media_end") or 0) - int(seg.get("media_start") or 0), 0
+            )
+        except (TypeError, ValueError):
+            media_count = 0
+        # The adapter already prefixes shared-group text with ``[name|id]``.
+        # Only name the sender ourselves when this segment has no text to
+        # carry that prefix, or the openid would print twice per block.
+        lines: List[str] = []
+        head = stamp
+        if not seg_text and sender:
+            head = f"{stamp} [{sender}]".strip()
+        if head:
+            lines.append(head)
+        if seg_text:
+            lines.append(seg_text)
+        if media_count and not seg_text:
+            # Media-only message: say so, so a bare timestamp+name block does
+            # not read as an empty message the model should ask about. The
+            # attachments themselves arrive natively with their own labels.
+            lines.append(
+                f"[sent {media_count} attachment(s), shown below]"
+                if media_count > 1
+                else "[sent an attachment, shown below]"
+            )
+        block = "\n".join(line for line in lines if line)
+        if block:
+            blocks.append(block)
