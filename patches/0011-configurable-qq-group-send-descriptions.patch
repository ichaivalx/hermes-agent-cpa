+def _group_send_descriptions(monkeypatch, section):
+    """Point the tool module's config reader at one fake extra section."""
+    import hermes_cli.config as hermes_config
+
+    config = {"platforms": {"qqbot": {"extra": {}}}}
+    if section is not None:
+        config["platforms"]["qqbot"]["extra"]["group_send_descriptions"] = section
+    monkeypatch.setattr(hermes_config, "load_config_readonly", lambda: config)
+
+
+def test_group_send_descriptions_default_to_the_built_in_text(monkeypatch):
+    from tools.qq_group_send_tool import (
+        QQ_GROUP_SEND_MEDIA_SCHEMA,
+        QQ_GROUP_SEND_SCHEMA,
+        _dynamic_group_send_media_schema,
+        _dynamic_group_send_schema,
+    )
+
+    _group_send_descriptions(monkeypatch, None)
+    assert _dynamic_group_send_schema() == {}
+    assert _dynamic_group_send_media_schema() == {}
+    # The built-in wording is what the model sees when nothing is configured.
+    assert "genuinely improve the conversation" in (
+        QQ_GROUP_SEND_SCHEMA["description"]
+    )
+    assert "fixed by the gateway" in QQ_GROUP_SEND_MEDIA_SCHEMA["description"]
+
+
+def test_group_send_descriptions_are_profile_configurable(monkeypatch):
+    from tools.qq_group_send_tool import (
+        _dynamic_group_send_media_schema,
+        _dynamic_group_send_schema,
+    )
+
+    _group_send_descriptions(monkeypatch, {
+        "send": "  Speak in this group whenever your persona would.  ",
+        "send_media": "Attach one bounded file to this group.",
+    })
+    assert _dynamic_group_send_schema() == {
+        "description": "Speak in this group whenever your persona would."
+    }
+    assert _dynamic_group_send_media_schema() == {
+        "description": "Attach one bounded file to this group."
+    }
+
+
+def test_group_send_descriptions_reach_the_model_tool_definitions(monkeypatch):
+    from tools.registry import registry
+
+    _group_send_descriptions(monkeypatch, {"send": "Persona-owned wording."})
+
+    definitions = {
+        entry["function"]["name"]: entry["function"]
+        for entry in registry.get_definitions(
+            {"qq_group_send", "qq_group_send_media"}, quiet=True
+        )
+    }
+    assert definitions["qq_group_send"]["description"] == "Persona-owned wording."
+    # An unset sibling keeps its built-in description.
+    assert "fixed by the gateway" in (
+        definitions["qq_group_send_media"]["description"]
+    )
+    # Configuration only replaces prose — the bounded parameter contract and
+    # the fixed destination are not configurable.
+    assert set(definitions["qq_group_send"]["parameters"]["properties"]) == {
+        "message"
+    }
+    assert definitions["qq_group_send"]["parameters"][
+        "additionalProperties"
+    ] is False
+
+
+def test_group_send_descriptions_ignore_unusable_config(monkeypatch):
+    from tools.qq_group_send_tool import (
+        _dynamic_group_send_media_schema,
+        _dynamic_group_send_schema,
+    )
+
+    _group_send_descriptions(monkeypatch, "not a mapping")
+    assert _dynamic_group_send_schema() == {}
+
+    _group_send_descriptions(monkeypatch, {"send": 42, "send_media": None})
+    assert _dynamic_group_send_schema() == {}
+    assert _dynamic_group_send_media_schema() == {}
+
+    # An explicit empty string suppresses the description, matching the
+    # group_prompts convention.
+    _group_send_descriptions(monkeypatch, {"send": ""})
+    assert _dynamic_group_send_schema() == {"description": ""}
+
+
