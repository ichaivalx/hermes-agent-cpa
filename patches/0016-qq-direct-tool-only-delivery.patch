+class _ClarifyCapturingQQAdapter(_CaptureQQAdapter):
+    """Addressed turns keep clarify, so the base adapter's assertion is wrong."""
+
+    def __init__(self):
+        super().__init__()
+        self.clarify_calls = []
+
+    async def send_clarify(self, *args, **kwargs) -> SendResult:
+        self.clarify_calls.append(kwargs.get("question") or (args[1] if len(args) > 1 else None))
+        # Reporting a failed send keeps the callback from blocking on a real
+        # answer while still proving it reached the adapter.
+        return SendResult(success=False, error="undeliverable in tests")
+
+
+class _AddressedToolOnlyAgent(_SilentDecisionAgent):
+    def run_conversation(self, message, conversation_history=None, **kwargs):
+        type(self).observed = {
+            "enabled_toolsets": self.enabled_toolsets,
+            "ephemeral_system_prompt": self.ephemeral_system_prompt,
+            "message": message,
+            "tool_progress": self.tool_progress_callback,
+            "stream_delta": self.stream_delta_callback,
+            "interim": self.interim_assistant_callback,
+        }
+        # Background-review text is model-authored, so it must not reach the
+        # group on a message-tool-only turn either.
+        if self.background_review_callback:
+            self.background_review_callback("must not be sent")
+        # Clarify stays interactive for someone who actually @-mentioned the
+        # bot; it must not return the ambient refusal sentinel.
+        type(self).observed["clarify_result"] = self.clarify_callback(
+            "Which one?", ["a", "b"]
+        )
+        return {
+            "final_response": "private addressed final",
+            "messages": [
+                {"role": "user", "content": message},
+                {"role": "assistant", "content": "private addressed final"},
+            ],
+            "api_calls": 1,
+            "completed": True,
+            "history_offset": 0,
+            "agent_persisted": False,
+        }
+
+
 def _make_runner(adapter):
     runner = object.__new__(gateway_run.GatewayRunner)
     runner.adapters = {Platform.QQBOT: adapter}
