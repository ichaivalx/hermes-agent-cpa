+    monkeypatch, tmp_path
+):
+    """A long ambient turn must not quote its own stale triggering msg_id.
+
+    QQ expires a quoted msg_id a few minutes after arrival, so an ambient
+    turn that thinks for a while has to re-read the anchor at send time.
+    """
