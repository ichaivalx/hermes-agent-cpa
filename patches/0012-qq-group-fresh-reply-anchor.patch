+    def latest_reply_anchor(self, chat_id: str) -> Optional[str]:
+        """Return the freshest inbound ``msg_id`` seen for one chat.
+
+        QQ retired proactive push: an outbound group message must quote a
+        recent inbound ``msg_id``, and the platform expires that anchor a
+        few minutes after the message arrived (error ``304027``). A long
+        ambient turn that captured its own triggering ``msg_id`` at start
+        can therefore find that anchor already dead by the time the model
+        decides to speak.
+
+        ``_last_msg_id`` is refreshed by :meth:`handle_message` for every
+        inbound event in the chat, including ordinary ``observe``-mode
+        traffic that never reaches the model. Reading it at send time picks
+        up whatever arrived while the turn was running. Public because
+        ``gateway/run.py`` needs it for request-scoped current-group
+        delivery, and reaching into the private dict from there would break
+        silently on an upstream rename.
+        """
+        key = str(chat_id or "").strip()
+        if not key:
+            return None
+        anchor = self._last_msg_id.get(key)
+        return anchor or None
+
