diff --git a/tests/gateway/test_leftover_steer_carry.py b/tests/gateway/test_leftover_steer_carry.py
new file mode 100644
index 0000000..e24ee1c
--- /dev/null
+++ b/tests/gateway/test_leftover_steer_carry.py
@@ -0,0 +1,269 @@
+"""A leftover steer must survive a non-empty pending queue.
+
+A follow-up sent while the agent is mid-turn lands in ``_pending_steer``. When
+the turn ends on a text response there is no tool batch left to inject it into,
+so ``turn_finalizer`` hands it back as ``result["pending_steer"]`` and the
+gateway delivers it as the next user turn instead.
+
+That handoff used to be gated on the queue being completely empty::
+
+    if result and not pending and not pending_event:
+
+which is exactly the condition that stops holding once a follow-up has parked
+its event in the pending slot — the common case rather than a corner one, since
+any media that announces itself mid-turn leaves its event queued for native
+delivery. A plain-text question sent during such a turn was discarded with no
+log line, no transcript row and no user-visible error: the model answered the
+images and ignored the question.
+
+``test_late_steer_survives_a_queued_event`` is the regression pin. The merged
+tests cover the burst path, where the model-facing text is rebuilt from the
+recorded segments and ``event.text`` is ignored entirely — so folding into the
+text alone would drop the carried question a second time, for exactly the
+bursts that trigger this bug most often.
+"""
+
+import sys
+
+import pytest
+
+import gateway.run as gateway_run
+from gateway.config import Platform
+from gateway.platforms.base import MERGED_SEGMENTS_KEY, MessageEvent, MessageType
+from gateway.session import SessionSource
+
+from tests.gateway.test_qq_direct_delivery import (  # noqa: E402
+    _CaptureQQAdapter,
+    _install_agent_fakes,
+    _make_runner,
+    _SilentDecisionAgent,
+)
+
+SESSION_KEY = "agent:main:qqbot:group:group-1"
+# ``_prepare_busy_steer_text`` has already stamped the steer by the time it
+# reaches the carry, so the text under test arrives pre-prefixed.
+STAMP = "[Fri 2026-08-21 09:46:00 CST]"
+STEER_BODY = "[chidori|B099] faceType=6 是什么意思"
+STEER = f"{STAMP}\n{STEER_BODY}"
+
+
+class _LateSteerAgent(_SilentDecisionAgent):
+    """Leak a steer out of turn 1, then record what turn 2 was handed."""
+
+    run_count = 0
+    turn_messages = []
+
+    def run_conversation(self, message, conversation_history=None, **kwargs):
+        type(self).run_count += 1
+        type(self).turn_messages.append(message)
+        result = super().run_conversation(
+            message, conversation_history=conversation_history, **kwargs
+        )
+        if type(self).run_count == 1:
+            result["pending_steer"] = STEER
+        return result
+
+
+def _setup(monkeypatch, tmp_path):
+    _install_agent_fakes(monkeypatch, tmp_path)
+    monkeypatch.setattr(sys.modules["run_agent"], "AIAgent", _LateSteerAgent)
+    _LateSteerAgent.run_count = 0
+    _LateSteerAgent.turn_messages = []
+    adapter = _CaptureQQAdapter()
+    return _make_runner(adapter), adapter
+
+
+def _source(user_id="member-1"):
+    return SessionSource(
+        platform=Platform.QQBOT,
+        chat_id="group-1",
+        chat_type="group",
+        user_id=user_id,
+    )
+
+
+def _merged_photo_event():
+    """A two-sender image burst, the shape that makes this bug reachable."""
+    segments = [
+        {
+            "text": "[ayaka|A001] 看这张",
+            "timestamp": 1755000000.0,
+            "sender": "ayaka|A001",
+            "media_start": 0,
+            "media_end": 1,
+        },
+        {
+            "text": "[bob|B002] 还有这张",
+            "timestamp": 1755000010.0,
+            "sender": "bob|B002",
+            "media_start": 1,
+            "media_end": 2,
+        },
+    ]
+    event = MessageEvent(
+        text="[ayaka|A001] 看这张\n\n[bob|B002] 还有这张",
+        message_type=MessageType.PHOTO,
+        media_urls=["/tmp/a.jpg", "/tmp/b.jpg"],
+        media_types=["image/jpeg", "image/jpeg"],
+        source=_source("member-2"),
+        metadata={MERGED_SEGMENTS_KEY: [dict(s) for s in segments]},
+    )
+    return event, segments
+
+
+def _capture_preprocessing(runner, seen):
+    """Stub inbound preprocessing, as ``test_qq_direct_delivery`` already does.
+
+    Keeps these tests on the carry itself rather than on the image/vision
+    pipeline the carried event is handed to, while still recording the text the
+    model would be shown.
+    """
+
+    async def capture(*, event, source, history, session_key=None):
+        del source, history, session_key
+        seen["event"] = event
+        seen["merged_text"] = gateway_run._build_merged_event_text(event)
+        seen["segments"] = gateway_run._event_merged_segments(event)
+        return event.text
+
+    runner._prepare_profile_scoped_inbound_message_text = capture
+
+
+async def _drive(runner, **overrides):
+    kwargs = {
+        "message": "ordinary chatter",
+        "context_prompt": "",
+        "history": [],
+        "source": _source(),
+        "session_id": "session-1",
+        "session_key": SESSION_KEY,
+        "channel_prompt": "",
+        "defer_intermediate_delivery": True,
+    }
+    kwargs.update(overrides)
+    return await runner._run_agent(**kwargs)
+
+
+@pytest.mark.asyncio
+async def test_late_steer_with_an_empty_queue_runs_a_second_turn(
+    monkeypatch, tmp_path
+):
+    """Upstream's own behaviour, pinned so the carry cannot regress it."""
+    runner, _adapter = _setup(monkeypatch, tmp_path)
+
+    await _drive(runner)
+
+    assert _LateSteerAgent.run_count == 2
+    assert STEER_BODY in _LateSteerAgent.turn_messages[1]
+
+
+@pytest.mark.asyncio
+async def test_late_steer_survives_a_queued_event(monkeypatch, tmp_path):
+    """The reported failure: a follow-up was queued, the question vanished."""
+    runner, adapter = _setup(monkeypatch, tmp_path)
+    adapter._pending_messages[SESSION_KEY] = MessageEvent(
+        text="[ayaka|A001] 顺便说一句",
+        message_type=MessageType.TEXT,
+        source=_source("member-2"),
+    )
+
+    await _drive(runner)
+
+    assert _LateSteerAgent.run_count == 2
+    drained = _LateSteerAgent.turn_messages[1]
+    # Both messages reach the model, in the order they were sent: the steer
+    # arrived mid-turn, before the queued follow-up was drained.
+    assert STEER_BODY in drained
+    assert "顺便说一句" in drained
+    assert drained.index(STEER_BODY) < drained.index("顺便说一句")
+
+
+@pytest.mark.asyncio
+async def test_late_steer_folds_into_a_queued_media_burst(monkeypatch, tmp_path):
+    """The production trigger: images queued mid-turn for native delivery."""
+    runner, adapter = _setup(monkeypatch, tmp_path)
+    event, segments = _merged_photo_event()
+    adapter._pending_messages[SESSION_KEY] = event
+    seen = {}
+    _capture_preprocessing(runner, seen)
+
+    await _drive(runner)
+
+    assert seen["event"] is event
+    # The question is in the text the model will actually be shown. For a
+    # merged burst that text is rebuilt from the segments, so a fold that only
+    # touched ``event.text`` would be discarded right here.
+    assert STEER_BODY in seen["merged_text"]
+    assert STEER_BODY in event.text
+    # It leads the burst, and the burst's own segments are untouched.
+    assert len(seen["segments"]) == 3
+    assert seen["segments"][0]["text"] == STEER
+    assert seen["segments"][1:] == segments
+    # The steer owns no pixels; claiming a span would double-count the images.
+    assert seen["segments"][0]["media_start"] == 0
+    assert seen["segments"][0]["media_end"] == 0
+    assert event.media_urls == ["/tmp/a.jpg", "/tmp/b.jpg"]
+
+
+@pytest.mark.asyncio
+async def test_folded_steer_keeps_its_single_stamp(monkeypatch, tmp_path):
+    """``_prepare_busy_steer_text`` already stamped it; a second stamp dupes.
+
+    The carried segment therefore sets no ``timestamp`` of its own — the
+    re-expansion must emit the block verbatim.
+    """
+    runner, adapter = _setup(monkeypatch, tmp_path)
+    event, _ = _merged_photo_event()
+    adapter._pending_messages[SESSION_KEY] = event
+    seen = {}
+    _capture_preprocessing(runner, seen)
+
+    await _drive(runner)
+
+    assert seen["merged_text"].count(STAMP) == 1
+    assert seen["segments"][0]["timestamp"] is None
+
+
+@pytest.mark.asyncio
+async def test_an_unfoldable_event_loses_neither_message(monkeypatch, tmp_path):
+    """A carry that cannot complete must not trade one loss for another.
+
+    The fold writes to ``event.text``; if that write raises, the steer falls
+    back to its own turn — and the follow-up has to go back on the queue rather
+    than being dropped, which is the very failure this whole branch exists to
+    fix. The recursive drain then picks it up, so both arrive: one turn each,
+    in order.
+    """
+    runner, adapter = _setup(monkeypatch, tmp_path)
+
+    class _FrozenTextEvent(MessageEvent):
+        """Rejects the fold's write the way an odd event object would.
+
+        The dataclass ``__init__`` assigns ``text`` itself, so only writes
+        after construction are refused.
+        """
+
+        _sealed = False
+
+        def __setattr__(self, name, value):
+            if name == "text" and self._sealed:
+                raise AttributeError("read-only text")
+            super().__setattr__(name, value)
+
+    frozen = _FrozenTextEvent(
+        text="[ayaka|A001] 顺便说一句",
+        message_type=MessageType.TEXT,
+        source=_source("member-2"),
+    )
+    frozen._sealed = True
+    adapter._pending_messages[SESSION_KEY] = frozen
+
+    await _drive(runner)
+
+    # Three turns: the original, the steer on its own, then the re-queued
+    # follow-up. Neither message was traded for the other.
+    assert _LateSteerAgent.run_count == 3
+    assert STEER_BODY in _LateSteerAgent.turn_messages[1]
+    assert "顺便说一句" in _LateSteerAgent.turn_messages[2]
+    # Consumed by the drain rather than left stranded in the slot.
+    assert adapter._pending_messages.get(SESSION_KEY) is None
