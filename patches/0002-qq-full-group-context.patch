+class _CaptureQQAdapter(BasePlatformAdapter):
+    def __init__(self):
+        super().__init__(PlatformConfig(enabled=True), Platform.QQBOT)
+        self.sent = []
+        self.sent_calls = []
+
+    async def connect(self, *, is_reconnect: bool = False) -> bool:
+        return True
+
+    async def disconnect(self) -> None:
+        return None
+
+    async def send(
+        self, chat_id, content, reply_to=None, metadata=None
+    ) -> SendResult:
+        self.sent.append(str(content))
+        self.sent_calls.append({
+            "chat_id": chat_id,
+            "content": str(content),
+            "reply_to": reply_to,
+        })
+        return SendResult(success=True, message_id="qq-progress")
+
+    async def send_typing(self, chat_id, metadata=None) -> None:
+        return None
+
+    async def stop_typing(self, chat_id) -> None:
+        return None
+
+    async def get_chat_info(self, chat_id: str):
+        return {"id": chat_id}
+
+    async def send_clarify(self, *args, **kwargs) -> SendResult:
+        raise AssertionError("deferred direct turns must not send clarify prompts")
+
+
+class _SilentDecisionAgent:
+    observed = {}
+
+    def __init__(self, **kwargs):
+        self.tools = []
+        self.enabled_toolsets = list(kwargs.get("enabled_toolsets") or [])
+        self.model = kwargs.get("model", "test-model")
+        self.provider = kwargs.get("provider", "test-provider")
+        self.session_id = kwargs.get("session_id", "session-1")
+        self.context_compressor = None
+        self.is_interrupted = False
+
+    def run_conversation(self, message, conversation_history=None, **kwargs):
+        type(self).observed = {
+            "enabled_toolsets": self.enabled_toolsets,
+            "tool_progress": self.tool_progress_callback,
+            "stream_delta": self.stream_delta_callback,
+            "interim": self.interim_assistant_callback,
+            "memory_notifications": self.memory_notifications,
+        }
+        if self.status_callback:
+            self.status_callback("working", "must not be sent")
+        if self.background_review_callback:
+            self.background_review_callback("must not be sent")
+        type(self).observed["clarify_result"] = self.clarify_callback(
+            "Should I speak?", ["yes", "no"]
+        )
+        return {
+            "final_response": "private ambient final",
+            "messages": [
+                {"role": "user", "content": message},
+                {"role": "assistant", "content": "private ambient final"},
+            ],
+            "api_calls": 1,
+            "completed": True,
+            "history_offset": 0,
+            "agent_persisted": False,
+        }
+
+
+class _ToolSpeakingAgent(_SilentDecisionAgent):
+    def run_conversation(self, message, conversation_history=None, **kwargs):
