diff --git a/tests/agent/test_tool_result_image_transport.py b/tests/agent/test_tool_result_image_transport.py
new file mode 100644
index 0000000..7ce3115
--- /dev/null
+++ b/tests/agent/test_tool_result_image_transport.py
@@ -0,0 +1,212 @@
+"""Cross-adapter pin: images in tool results must survive the wire.
+
+Multimodal tool results (``vision_analyze``, ``computer_use`` screenshots,
+browser captures) arrive as an OpenAI-style content list on a ``role: "tool"``
+message.  Two adapters used to serialize that list as text only, which drops the
+image parts.
+
+The failure mode is what makes this worth a dedicated pin: nothing errors.  The
+model receives a tool result announcing that an image was loaded, sees no
+pixels, and — as verified live against gemini-3.7-flash-high — invents a
+confident description rather than reporting that it can't see anything.  A
+control probe that explicitly instructed the model to answer ``NO_IMAGE`` when
+blind still got a fabricated answer.  So a silently-text-only tool result reads
+as a working feature right up until the description is checked against the
+actual picture.
+"""
+
+from __future__ import annotations
+
+import base64
+import json
+
+import pytest
+
+# 1x1 PNG.
+_TINY_PNG = base64.b64decode(
+    b"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII="
+)
+_B64 = base64.b64encode(_TINY_PNG).decode("ascii")
+_DATA_URL = f"data:image/png;base64,{_B64}"
+
+
+def _messages(image_count: int = 1) -> list:
+    """A minimal history ending in a multimodal tool result."""
+    parts: list = [{"type": "text", "text": "Image loaded into your context."}]
+    for _ in range(image_count):
+        parts.append({"type": "image_url", "image_url": {"url": _DATA_URL}})
+    return [
+        {"role": "user", "content": "look at the image"},
+        {
+            "role": "assistant",
+            "content": None,
+            "tool_calls": [
+                {
+                    "id": "call_x",
+                    "type": "function",
+                    "function": {"name": "vision_analyze", "arguments": "{}"},
+                }
+            ],
+        },
+        {
+            "role": "tool",
+            "tool_call_id": "call_x",
+            "name": "vision_analyze",
+            "content": parts,
+        },
+    ]
+
+
+class TestGeminiNativeToolResultImages:
+    def test_image_survives_as_inline_blob(self):
+        from agent.gemini_native_adapter import _build_gemini_contents
+
+        contents, _sys = _build_gemini_contents(_messages())
+        fr = None
+        for content in contents:
+            for part in content.get("parts", []):
+                if isinstance(part, dict) and "functionResponse" in part:
+                    fr = part["functionResponse"]
+        assert fr is not None, "no functionResponse emitted for the tool result"
+        blobs = fr.get("parts") or []
+        assert len(blobs) == 1, f"expected 1 inline blob, got {len(blobs)}"
+        assert blobs[0]["inlineData"]["mimeType"] == "image/png"
+        assert blobs[0]["inlineData"]["data"] == _B64
+
+    def test_all_images_of_a_batch_survive(self):
+        from agent.gemini_native_adapter import _build_gemini_contents
+
+        contents, _sys = _build_gemini_contents(_messages(image_count=3))
+        blobs = [
+            part["functionResponse"].get("parts") or []
+            for content in contents
+            for part in content.get("parts", [])
+            if isinstance(part, dict) and "functionResponse" in part
+        ]
+        assert blobs and len(blobs[0]) == 3
+
+    def test_blob_is_not_nested_under_response(self):
+        """``functionResponse.response.parts`` is the wrong place.
+
+        Live-verified: nesting the blob under ``response`` makes the model read
+        the base64 as text instead of seeing an image (prompt tokens 8485 vs
+        1210 for the same 9 KB PNG, and it could not name the word in it).
+        """
+        from agent.gemini_native_adapter import _build_gemini_contents
+
+        contents, _sys = _build_gemini_contents(_messages())
+        for content in contents:
+            for part in content.get("parts", []):
+                if isinstance(part, dict) and "functionResponse" in part:
+                    response = part["functionResponse"].get("response") or {}
+                    assert _B64 not in json.dumps(response), (
+                        "base64 leaked into functionResponse.response — the "
+                        "model would read the payload as text"
+                    )
+
+    def test_no_text_parts_inside_function_response_parts(self):
+        """Gemini rejects text parts in ``functionResponse.parts`` with a 400.
+
+        Live error: ``Unknown name "text" at ...function_response.parts[0]``.
+        Labels therefore belong in ``response``, never interleaved with blobs.
+        """
+        from agent.gemini_native_adapter import _build_gemini_contents
+
+        contents, _sys = _build_gemini_contents(_messages(image_count=2))
+        for content in contents:
+            for part in content.get("parts", []):
+                if isinstance(part, dict) and "functionResponse" in part:
+                    for blob in part["functionResponse"].get("parts") or []:
+                        assert set(blob) == {"inlineData"}, (
+                            f"non-blob part in functionResponse.parts: {list(blob)}"
+                        )
+
+    def test_text_only_tool_result_has_no_parts_key(self):
+        """No regression for ordinary tool results: no empty ``parts``."""
+        from agent.gemini_native_adapter import _build_gemini_contents
+
+        messages = _messages()
+        messages[-1]["content"] = "plain text result"
+        contents, _sys = _build_gemini_contents(messages)
+        for content in contents:
+            for part in content.get("parts", []):
+                if isinstance(part, dict) and "functionResponse" in part:
+                    assert "parts" not in part["functionResponse"]
+
+
+class TestAnthropicToolResultImages:
+    def test_image_survives_as_image_block(self):
+        from agent.anthropic_adapter import convert_messages_to_anthropic
+
+        _system, messages = convert_messages_to_anthropic(_messages(image_count=2))
+        blocks = [
+            block
+            for msg in messages
+            for block in (msg.get("content") or [])
+            if isinstance(block, dict)
+        ]
+        images = [b for b in blocks if b.get("type") == "image"]
+        nested = [
+            inner
+            for b in blocks
+            if b.get("type") == "tool_result"
+            for inner in (b.get("content") or [])
+            if isinstance(inner, dict) and inner.get("type") == "image"
+        ]
+        assert len(images) + len(nested) == 2, (
+            f"expected 2 image blocks, got {len(images) + len(nested)}"
+        )
+
+
+class TestBedrockToolResultImages:
+    def test_image_survives_as_image_block(self):
+        from agent.bedrock_adapter import convert_messages_to_converse
+
+        _system, messages = convert_messages_to_converse(_messages(image_count=2))
+        images = [
+            block
+            for msg in messages
+            for outer in (msg.get("content") or [])
+            if isinstance(outer, dict) and "toolResult" in outer
+            for block in (outer["toolResult"].get("content") or [])
+            if isinstance(block, dict) and "image" in block
+        ]
+        assert len(images) == 2, f"expected 2 image blocks, got {len(images)}"
+
+    def test_base64_does_not_leak_as_text(self):
+        from agent.bedrock_adapter import convert_messages_to_converse
+
+        _system, messages = convert_messages_to_converse(_messages())
+        for msg in messages:
+            for outer in msg.get("content") or []:
+                if not (isinstance(outer, dict) and "toolResult" in outer):
+                    continue
+                for block in outer["toolResult"].get("content") or []:
+                    if isinstance(block, dict) and "text" in block:
+                        assert _B64 not in str(block["text"]), (
+                            "base64 leaked into a text block — the model would "
+                            "see no image at all"
+                        )
+
+
+class TestCodexResponsesToolResultImages:
+    def test_image_survives_as_input_image(self):
+        try:
+            from agent.codex_responses_adapter import _chat_messages_to_responses_input
+        except ImportError:  # pragma: no cover - name drift guard
+            pytest.skip("responses input builder not importable under this name")
+
+        items = _chat_messages_to_responses_input(_messages(image_count=2))
+        outputs = [
+            it for it in items
+            if isinstance(it, dict) and it.get("type") == "function_call_output"
+        ]
+        assert outputs, "no function_call_output emitted"
+        images = [
+            part
+            for out in outputs
+            if isinstance(out.get("output"), list)
+            for part in out["output"]
+            if isinstance(part, dict) and part.get("type") == "input_image"
+        ]
+        assert len(images) == 2, f"expected 2 input_image parts, got {len(images)}"
