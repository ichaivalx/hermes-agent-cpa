+    labels: List[str] = []
+    any_sender = False
+    # Walk ``media_urls`` with a cursor instead of ``.index(path)``: the same
+    # path can legitimately appear twice in one event (a quoted image is
+    # appended to the caption's own list — adapter.py's ``image_urls +
+    # quoted["image_urls"]``), and a by-value lookup returns the FIRST index
+    # every time, so both copies would be attributed to whoever owns the first
+    # one. Consuming indices in order keeps each occurrence on its own segment.
+    _cursor = 0
+    for path in image_paths:
+        media_index = -1
+        for _probe in range(_cursor, len(media_urls)):
+            if media_urls[_probe] == path:
