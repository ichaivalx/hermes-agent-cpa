+@pytest.mark.asyncio
+async def test_direct_addressed_turn_is_tool_only_but_stays_interactive(
+    monkeypatch, tmp_path
+):
+    _install_agent_fakes(monkeypatch, tmp_path)
+    sys.modules["run_agent"].AIAgent = _AddressedToolOnlyAgent
+    adapter = _ClarifyCapturingQQAdapter()
+    runner = _make_runner(adapter)
+    source = SessionSource(
+        platform=Platform.QQBOT,
+        chat_id="group-1",
+        chat_type="group",
+        user_id="member-1",
+    )
+
+    result = await runner._run_agent(
+        message="@bot explicit question",
+        context_prompt="",
+        history=[],
+        source=source,
+        session_id="session-1",
+        session_key="agent:main:qqbot:group:group-1",
+        channel_prompt="Speaking requires qq_group_send.",
+        defer_intermediate_delivery=False,
+        visible_send_requires_tool=True,
+    )
+    observed = _AddressedToolOnlyAgent.observed
+
+    # The whole point of the flag: an addressed direct turn can only speak
+    # through the send tool, so it must actually get the tool.
+    assert "qq_group_send" in observed["enabled_toolsets"]
+    # Model-authored mid-turn surfaces stay private, exactly as on an
+    # ambient turn.
+    assert observed["stream_delta"] is None
+    assert observed["interim"] is None
+    assert adapter.sent == []
+    # ...but the interactive surfaces an @ turn needs are untouched, which is
+    # what separates this flag from defer_intermediate_delivery.
+    assert observed["tool_progress"] is not None
+    assert "unavailable for an unaddressed group turn" not in (
+        observed["clarify_result"]
+    )
+    # _run_agent still returns the private final; suppression happens on the
+    # delivery side so the transcript keeps the model's own words.
+    assert result["final_response"] == "private addressed final"
+
+
