diff --git a/tests/gateway/test_qqbot.py b/tests/gateway/test_qqbot.py
index 859f8f4..e5fc5dc 100644
--- a/tests/gateway/test_qqbot.py
+++ b/tests/gateway/test_qqbot.py
@@ -2308,3 +2308,148 @@ class TestAnchorlessResendAfterExpiredAnchor:
         assert len(bodies) == 2
         assert bodies[0]["msg_id"] == "msg-1"
         assert "msg_id" not in bodies[1]
+
+
+class TestAnchorlessMediaRepostAfterExpiredAnchor:
+    """A refused anchor on the media path re-POSTs the existing upload.
+
+    Image generation regularly outlives the few minutes QQ keeps an anchor
+    alive, so this class of failure hits media harder than text. Production
+    2026-08-19 16:30: a 665 KB render was uploaded, refused with 40034005,
+    and the whole upload ran a second time only to be refused again.
+    """
+
+    def _make_adapter(self):
+        from gateway.platforms.qqbot.adapter import QQAdapter
+
+        adapter = QQAdapter(_make_config(app_id="a", client_secret="b"))
+        adapter._running = True
+        adapter._ws = SimpleNamespace(closed=False)
+        adapter._chat_type_map["group-1"] = "group"
+        adapter._upload_local_file = mock.AsyncMock(
+            return_value=("image.png", {"file_info": "upload-token"})
+        )
+        return adapter
+
+    _EXPIRED = (
+        "QQ Bot API error [400] code=40034005 "
+        "/v2/groups/group-1/messages: 回复消息msg_id已过期"
+    )
+
+    async def _send(self, adapter, **kwargs):
+        from gateway.platforms.qqbot.adapter import MEDIA_TYPE_IMAGE
+
+        return await adapter._send_media(
+            "group-1",
+            "/tmp/image.png",
+            MEDIA_TYPE_IMAGE,
+            "image",
+            **kwargs,
+        )
+
+    @pytest.mark.asyncio
+    async def test_repost_delivers_without_reuploading(self):
+        adapter = self._make_adapter()
+        bodies = []
+
+        async def fake_api_request(method, path, body=None, timeout=None):
+            bodies.append(body)
+            if body and body.get("msg_id"):
+                raise RuntimeError(self._EXPIRED)
+            return {"id": "ROBOT1.0_pushed"}
+
+        adapter._api_request = fake_api_request  # type: ignore[assignment]
+
+        result = await self._send(adapter, reply_to="msg-1")
+
+        assert result.success is True
+        assert result.message_id == "ROBOT1.0_pushed"
+        assert len(bodies) == 2
+        assert bodies[0]["msg_id"] == "msg-1"
+        assert "msg_id" not in bodies[1]
+        # The whole point: the bytes go up once, not once per attempt.
+        assert adapter._upload_local_file.await_count == 1
+        assert bodies[1]["media"]["file_info"] == "upload-token"
+
+    @pytest.mark.asyncio
+    async def test_repost_happens_exactly_once(self):
+        """Both POSTs refused — no third attempt, and non-retryable."""
+        adapter = self._make_adapter()
+        attempts = []
+
+        async def fake_api_request(method, path, body=None, timeout=None):
+            attempts.append((body or {}).get("msg_id"))
+            raise RuntimeError(self._EXPIRED)
+
+        adapter._api_request = fake_api_request  # type: ignore[assignment]
+
+        result = await self._send(adapter, reply_to="msg-1")
+
+        assert result.success is False
+        assert result.retryable is False
+        assert "40034005" in (result.error or "")
+        assert "anchorless media re-post" in (result.error or "")
+        assert attempts == ["msg-1", None]
+        assert adapter._upload_local_file.await_count == 1
+
+    @pytest.mark.asyncio
+    async def test_no_repost_when_nothing_was_quoted(self):
+        """Without an anchor there is nothing to drop — do not double-send."""
+        adapter = self._make_adapter()
+        attempts = []
+
+        async def fake_api_request(method, path, body=None, timeout=None):
+            attempts.append((body or {}).get("msg_id"))
+            raise RuntimeError(self._EXPIRED)
+
+        adapter._api_request = fake_api_request  # type: ignore[assignment]
+
+        result = await self._send(adapter)
+
+        assert result.success is False
+        assert attempts == [None]
+
+    @pytest.mark.asyncio
+    async def test_unrelated_failure_is_not_reposted(self):
+        """Only the dead-anchor class falls back; content refusal must not."""
+        adapter = self._make_adapter()
+        attempts = []
+
+        async def fake_api_request(method, path, body=None, timeout=None):
+            attempts.append((body or {}).get("msg_id"))
+            raise RuntimeError(
+                "QQ Bot API error [400] code=40034006 "
+                "/v2/groups/group-1/messages: 消息内容违规"
+            )
+
+        adapter._api_request = fake_api_request  # type: ignore[assignment]
+
+        result = await self._send(adapter, reply_to="msg-1")
+
+        assert result.success is False
+        assert "40034006" in (result.error or "")
+        assert attempts == ["msg-1"]
+
+    @pytest.mark.asyncio
+    async def test_revoked_turn_skips_the_repost(self):
+        """A /stop between the two POSTs must not still push the media."""
+        adapter = self._make_adapter()
+        attempts = []
+
+        async def fake_api_request(method, path, body=None, timeout=None):
+            attempts.append((body or {}).get("msg_id"))
+            raise RuntimeError(self._EXPIRED)
+
+        adapter._api_request = fake_api_request  # type: ignore[assignment]
+        # True for the entry guard and the pre-POST recheck, then revoked.
+        lease_checks = iter((True, True, False))
+
+        result = await self._send(
+            adapter,
+            reply_to="msg-1",
+            should_continue=lambda: next(lease_checks),
+        )
+
+        assert result.success is False
+        assert result.error == "Media delivery cancelled"
+        assert attempts == ["msg-1"]
