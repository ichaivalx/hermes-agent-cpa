@@ -0,0 +1,121 @@
+"""Tests for the configurable mid-turn steering note.
+
+``agent.steer_channel_note`` in config.yaml overrides the built-in
+STEER_CHANNEL_NOTE with the same three-state convention the QQ group
+prompts and tool descriptions use: key absent keeps the built-in text, a
+non-empty string replaces it, and ``""`` drops the note entirely.
+
+The built-in text grants out-of-band marker content "the same authority
+as their original request". That is right for a 1:1 session, but a shared
+group session running ``display.busy_input_mode: steer`` delivers ordinary
+chatter from any participant through that same marker, so the wording has
+to be rewritable per Profile without forking the image.
+"""
+
+from types import SimpleNamespace
+from unittest.mock import patch
+
+from agent.prompt_builder import STEER_CHANNEL_NOTE, resolve_steer_channel_note
+from agent.system_prompt import build_system_prompt_parts
+
+
+class TestResolveSteerChannelNote:
+    def test_absent_key_keeps_builtin(self):
+        # None is the "not configured" sentinel — the caller injects the
+        # built-in note, so absence must never resolve to "".
+        assert resolve_steer_channel_note({}) is None
+        assert resolve_steer_channel_note({"task_completion_guidance": True}) is None
+
+    def test_string_replaces(self):
+        assert resolve_steer_channel_note({"steer_channel_note": "MINE"}) == "MINE"
+
+    def test_surrounding_whitespace_stripped(self):
+        # YAML block scalars carry a trailing newline; the note is joined
+        # into the prompt with explicit separators.
+        assert resolve_steer_channel_note({"steer_channel_note": "\nMINE\n"}) == "MINE"
+
+    def test_empty_string_suppresses(self):
+        assert resolve_steer_channel_note({"steer_channel_note": ""}) == ""
+
+    def test_whitespace_only_suppresses(self):
+        assert resolve_steer_channel_note({"steer_channel_note": "   \n"}) == ""
+
+    def test_non_string_falls_back_to_builtin(self):
+        # Includes the bare `steer_channel_note:` key with no value, which
+        # YAML parses as None — a typo must not silently drop the note.
+        for bad in (None, 123, True, ["a"], {"a": 1}):
+            assert resolve_steer_channel_note({"steer_channel_note": bad}) is None
+
+    def test_non_mapping_section_falls_back_to_builtin(self):
+        for bad in (None, "steer", ["steer_channel_note"], 5):
+            assert resolve_steer_channel_note(bad) is None
+
+
+def _make_agent(**overrides):
+    base = dict(
+        load_soul_identity=False,
+        skip_context_files=False,
+        valid_tool_names=["read_file"],
+        _task_completion_guidance=False,
+        _parallel_tool_call_guidance=False,
+        _tool_use_enforcement=False,
+        _environment_probe=False,
+        _kanban_worker_guidance="",
+        _memory_store=None,
+        _memory_manager=None,
+        model="",
+        provider="",
+        platform="",
+        pass_session_id=False,
+        session_id="",
+    )
+    base.update(overrides)
+    return SimpleNamespace(**base)
+
+
+def _stable_prompt(agent):
+    with (
+        patch("run_agent.load_soul_md", return_value=""),
+        patch("run_agent.build_nous_subscription_prompt", return_value=""),
+        patch("run_agent.build_environment_hints", return_value=""),
+        patch("run_agent.build_context_files_prompt", return_value=""),
+        patch("agent.coding_context._coding_mode", return_value="off"),
+    ):
+        return build_system_prompt_parts(agent)["stable"]
+
+
+class TestSteerNoteInjection:
+    def test_builtin_when_attribute_missing(self):
+        # Code paths that bypass agent_init must still get the note.
+        assert STEER_CHANNEL_NOTE in _stable_prompt(_make_agent())
+
+    def test_builtin_when_not_configured(self):
+        agent = _make_agent(_steer_channel_note=None)
+        assert STEER_CHANNEL_NOTE in _stable_prompt(agent)
+
+    def test_configured_string_replaces_builtin(self):
+        agent = _make_agent(_steer_channel_note="CUSTOM STEER NOTE")
+        stable = _stable_prompt(agent)
+        assert "CUSTOM STEER NOTE" in stable
+        assert STEER_CHANNEL_NOTE not in stable
+
+    def test_empty_string_injects_nothing(self):
+        stable = _stable_prompt(_make_agent(_steer_channel_note=""))
+        assert STEER_CHANNEL_NOTE not in stable
+
+    def test_tool_gate_still_wins(self):
+        # Steering only lands inside tool results, so a toolless agent gets
+        # no note no matter what is configured.
+        agent = _make_agent(valid_tool_names=[], _steer_channel_note="CUSTOM STEER NOTE")
+        stable = _stable_prompt(agent)
+        assert "CUSTOM STEER NOTE" not in stable
+        assert STEER_CHANNEL_NOTE not in stable
+
+    def test_config_section_reaches_the_prompt(self):
+        # The two halves line up: what the resolver returns is what the
+        # prompt builder injects.
+        section = {"steer_channel_note": "  Group steering: use your judgment.  "}
+        agent = _make_agent(_steer_channel_note=resolve_steer_channel_note(section))
+        stable = _stable_prompt(agent)
+        assert "Group steering: use your judgment." in stable
+        assert STEER_CHANNEL_NOTE not in stable
