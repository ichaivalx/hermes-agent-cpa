+# ----------------------------------------------------------------------
+# Profile-configurable tool descriptions
+# ----------------------------------------------------------------------
+# The default descriptions above carry an editorial nudge ("call this only
+# when speaking would genuinely improve the conversation") that competes
+# with a Profile's own persona instructions. Operators who write their own
+# persona need to be able to replace that wording without forking the
+# image, so both descriptions are overridable from the active Profile's
+# config.yaml:
+#
+#   platforms:
+#     qqbot:
+#       extra:
+#         group_send_descriptions:
+#           send: "..."
+#           send_media: "..."
+#
+# Only the model-facing ``description`` is configurable. Parameter schemas,
+# the fixed destination and every delivery boundary stay in code — a wrong
+# or hostile description cannot widen what these tools can reach.
+
+_DESCRIPTION_CONFIG_KEYS = {
+    "qq_group_send": "send",
+    "qq_group_send_media": "send_media",
+}
+
+
+def _configured_group_send_description(tool_name: str) -> Optional[str]:
+    """Return the Profile's override for one tool description, if any.
+
+    Returns ``None`` when the key is absent or unusable so the caller keeps
+    the built-in default. An explicit empty string is honored as "no
+    description" — the same convention ``group_prompts`` already uses for
+    suppressing an injected prompt.
+    """
+    config_key = _DESCRIPTION_CONFIG_KEYS.get(tool_name)
+    if config_key is None:
+        return None
+    try:
+        from hermes_cli.config import cfg_get, load_config_readonly
+
+        section = cfg_get(
+            load_config_readonly(),
+            "platforms", "qqbot", "extra", "group_send_descriptions",
+        )
+        if section is None:
+            return None
+        if not isinstance(section, dict):
+            logger.warning(
+                "Ignoring non-mapping platforms.qqbot.extra."
+                "group_send_descriptions; using built-in tool descriptions"
+            )
+            return None
+        if config_key not in section:
+            return None
+        value = section[config_key]
+        if not isinstance(value, str):
+            logger.warning(
+                "Ignoring non-string group_send_descriptions.%s; using the "
+                "built-in description for %s",
+                config_key, tool_name,
+            )
+            return None
+        return value.strip()
+    except Exception as exc:
+        logger.debug(
+            "Could not read group_send_descriptions.%s: %s", config_key, exc
+        )
+    return None
+
+
+def _dynamic_group_send_schema() -> Dict[str, Any]:
+    override = _configured_group_send_description("qq_group_send")
+    return {} if override is None else {"description": override}
+
+
+def _dynamic_group_send_media_schema() -> Dict[str, Any]:
+    override = _configured_group_send_description("qq_group_send_media")
+    return {} if override is None else {"description": override}
+
+
