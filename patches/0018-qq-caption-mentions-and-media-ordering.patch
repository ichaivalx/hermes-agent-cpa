+# ---------------------------------------------------------------------------
+# 6. The steer gate: announce mid-turn AND still queue the pixels
+# ---------------------------------------------------------------------------
+
+
+def _busy_runner():
+    """A GatewayRunner wired just enough to reach the busy steer gate."""
+    runner = object.__new__(gateway_run.GatewayRunner)
+    runner._sessions = {}
+    runner._pending_messages = {}
+    runner._draining = False
+    runner.adapters = {}
+    runner.config = MagicMock()
+    runner.hooks = MagicMock()
+    runner.hooks.emit = AsyncMock()
+    runner._is_user_authorized = lambda _source: True
+    runner._effective_busy_input_mode = MagicMock(return_value="steer")
+    runner._effective_busy_text_mode = MagicMock(return_value="steer")
+    runner._agent_has_active_subagents = MagicMock(return_value=False)
+    runner._session_has_compression_in_flight = AsyncMock(return_value=False)
+    runner._pending_event_audio_paths = MagicMock(return_value=[])
+    runner._queue_or_replace_pending_event = MagicMock()
+    runner._reply_anchor_for_event = MagicMock(return_value=None)
+    runner._thread_metadata_for_source = MagicMock(return_value={})
+    return runner
+
+
+def _busy_adapter():
+    adapter = MagicMock()
+    adapter._pending_messages = {}
+    adapter._send_with_retry = AsyncMock()
+    adapter._unwrap_ephemeral = MagicMock(return_value=("", None))
+    adapter.config = MagicMock()
+    adapter.config.extra = {}
+    adapter.platform = Platform.QQBOT
+    return adapter
+
+
+def _running_agent(steer_returns=True):
+    agent = MagicMock()
+    agent.steer = MagicMock(return_value=steer_returns)
+    agent._active_children = []
+    agent.get_activity_summary.return_value = {
+        "api_call_count": 3,
+        "max_iterations": 60,
+        "current_tool": "terminal",
+    }
+    return agent
+
+
+def _drive_busy_handler(event, agent, *, cfg=None):
+    """Run the real busy handler against a session that is mid-turn."""
+    runner = _busy_runner()
+    adapter = _busy_adapter()
+    session_key = "qq:group-1"
+    runner._sessions[session_key] = SimpleNamespace(
+        turn=SimpleNamespace(
+            agent=agent,
+            defer_intermediate_delivery=False,
+            busy_ack_ts=0,
+            started_ts=0,
+        )
+    )
+    runner._adapter_for_source = MagicMock(return_value=adapter)
+    runner._session_state = MagicMock(
+        return_value=runner._sessions[session_key]
+    )
+
+    with patch.object(
+        gateway_run, "_load_gateway_config", return_value=cfg or {}
+    ), patch(
+        "gateway.display_config.resolve_display_setting", return_value=False
+    ):
+        handled = asyncio.run(
+            runner._handle_active_session_busy_message(event, session_key)
+        )
+    return runner, adapter, handled, session_key
+
+
+def test_mid_turn_image_is_announced_and_still_queued():
+    """The announce adds ordering info; it must not consume the event."""
+    agent = _running_agent()
+    event = _image_event(
+        text="[chidori|B099F32B]",
+        timestamp=datetime(2026, 8, 20, 8, 12, 44, tzinfo=timezone.utc),
+    )
+    runner, _adapter, handled, session_key = _drive_busy_handler(event, agent)
+
+    assert handled is True
+    # Announced in-band...
+    agent.steer.assert_called_once()
+    announced = agent.steer.call_args.args[0]
+    assert _PHOTO_PATH in announced
+    assert "chidori|B099F32B" in announced
+    # ...and still queued, so the pixels arrive natively next turn.
+    runner._queue_or_replace_pending_event.assert_called_once_with(
+        session_key, event
+    )
+
+
+def test_mid_turn_image_on_another_platform_is_not_announced():
+    agent = _running_agent()
+    event = _image_event(
+        source=SessionSource(
+            platform=Platform.TELEGRAM,
+            chat_id="group-1",
+            chat_type="group",
+            user_id="B099F32B",
+            user_name="chidori",
+        )
+    )
+    runner, _adapter, _handled, session_key = _drive_busy_handler(event, agent)
+
+    agent.steer.assert_not_called()
+    runner._queue_or_replace_pending_event.assert_called_once_with(
+        session_key, event
+    )
+
+
+def test_plain_text_still_steers_and_is_not_queued():
+    """The new branch is an elif — the normal steer path is untouched."""
+    agent = _running_agent()
+    event = MessageEvent(
+        text="just text",
+        message_type=MessageType.TEXT,
+        source=SessionSource(
+            platform=Platform.QQBOT,
+            chat_id="group-1",
+            chat_type="group",
+            user_id="B099F32B",
+            user_name="chidori",
+        ),
+    )
+    runner, _adapter, handled, _sk = _drive_busy_handler(event, agent)
+
+    assert handled is True
+    agent.steer.assert_called_once_with("just text")
+    runner._queue_or_replace_pending_event.assert_not_called()
+
+
+def test_failed_announce_leaves_the_event_queued():
