+def _strip_sender_prefix(text: str, sender: str) -> str:
+    """Return ``text`` minus a leading ``[sender]`` label, stripped.
+
+    Shared-group adapters prefix every inbound message with ``[name|id]``
+    unconditionally, so "did this sender type anything?" cannot be answered by
+    testing the text for emptiness — a media-only message carries the prefix
+    and nothing else.  Remove the label the adapter added and let the caller
+    judge the remainder.
+
+    Only an exact leading ``[<sender>]`` is removed, so a caption that merely
+    mentions someone in brackets is never truncated.  A segment is plain dict
+    data that survives a persist/replay round trip: when ``sender`` is unknown
+    or the prefix is absent, return the text unchanged rather than guessing at
+    a bracket boundary.
+    """
+    body = str(text or "").strip()
+    label = str(sender or "").strip()
+    if not body or not label:
+        return body
+    prefix = f"[{label}]"
+    if not body.startswith(prefix):
+        return body
+    return body[len(prefix):].strip()
+
