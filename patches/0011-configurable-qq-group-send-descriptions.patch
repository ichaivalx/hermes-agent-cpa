     handler=lambda args, **_kwargs: qq_group_send(args.get("message", "")),
     emoji="💬",
+    dynamic_schema_overrides=_dynamic_group_send_schema,
 )
 registry.register(
     name="qq_group_send_media",
@@ -292,4 +378,5 @@ registry.register(
