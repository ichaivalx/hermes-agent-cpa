+@pytest.mark.asyncio
+async def test_full_agent_direct_turn_holds_all_intermediate_delivery(
+    monkeypatch, tmp_path
+):
+    _install_agent_fakes(monkeypatch, tmp_path)
+    adapter = _CaptureQQAdapter()
+    runner = _make_runner(adapter)
+    source = SessionSource(
+        platform=Platform.QQBOT,
+        chat_id="group-1",
+        chat_type="group",
+        user_id="member-1",
+    )
+
+    result = await runner._run_agent(
+        message="[Alice|member-1]\nordinary chatter",
+        context_prompt="",
+        history=[],
+        source=source,
+        session_id="session-1",
+        session_key="agent:main:qqbot:group:group-1",
+        channel_prompt="Return NO_REPLY when silence is better.",
+        defer_intermediate_delivery=True,
+    )
+
+    assert result["final_response"] == SILENT_REPLY_TOKEN
+    assert adapter.sent == []
+    assert _SilentDecisionAgent.observed["tool_progress"] is None
+    assert _SilentDecisionAgent.observed["stream_delta"] is None
+    assert _SilentDecisionAgent.observed["interim"] is None
+    assert _SilentDecisionAgent.observed["memory_notifications"] == "off"
+    assert "unavailable" in _SilentDecisionAgent.observed["clarify_result"]
